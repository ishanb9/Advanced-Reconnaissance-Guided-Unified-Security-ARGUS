<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ARGUS Security Assessment — {{ target_display }} — CONFIDENTIAL</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ============================================================
   ARGUS EXECUTIVE CONSULTANCY REPORT — COMPLETE STYLESHEET
   ============================================================ */

/* ── Reset & Base ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  /* Blue palette */
  --blue-900: #0a1628;
  --blue-800: #0b2044;
  --blue-700: #0b3060;
  --blue-600: #0b4080;
  --blue-500: #0b55a8;
  --blue-400: #0b66c3;
  --blue-300: #1a7fd4;
  --blue-200: #4da3e8;
  --blue-100: #d0e8f8;
  --blue-50:  #f0f7fd;

  /* Neutrals */
  --gray-950: #0d0f14;
  --gray-900: #1a1d24;
  --gray-800: #2d3142;
  --gray-700: #474c62;
  --gray-600: #626780;
  --gray-500: #838799;
  --gray-400: #a4a8b8;
  --gray-300: #c8cad6;
  --gray-200: #e2e4ec;
  --gray-100: #f1f2f6;
  --gray-50:  #f8f9fc;
  --white:    #ffffff;

  /* Severity palette */
  --sev-critical-bg:  #fff0f0;
  --sev-critical-bdr: #e8112d;
  --sev-critical-txt: #b30e24;
  --sev-critical-dot: #e8112d;

  --sev-high-bg:  #fff5ed;
  --sev-high-bdr: #e85d04;
  --sev-high-txt: #b84d00;
  --sev-high-dot: #e85d04;

  --sev-medium-bg:  #fffbea;
  --sev-medium-bdr: #d4a017;
  --sev-medium-txt: #9c7500;
  --sev-medium-dot: #d4a017;

  --sev-low-bg:  #f0faf3;
  --sev-low-bdr: #19a34a;
  --sev-low-txt: #157339;
  --sev-low-dot: #19a34a;

  --sev-info-bg:  #f0f7fd;
  --sev-info-bdr: #0b66c3;
  --sev-info-txt: #084d94;
  --sev-info-dot: #0b66c3;

  /* Outcome palette */
  --out-exploitable: #e8112d;
  --out-negative:    #19a34a;
  --out-blocked:     #d4a017;
  --out-success:     #0b66c3;

  /* Typography */
  --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
  --font-mono: 'IBM Plex Mono', 'Cascadia Code', monospace;

  /* Spacing */
  --page-pad: 48px;
  --section-gap: 56px;
  --card-radius: 8px;
  --border: 1px solid var(--gray-200);
}

html { font-size: 14px; }

body {
  font-family: var(--font-sans);
  font-size: 14px;
  line-height: 1.6;
  color: var(--gray-900);
  background: var(--white);
  -webkit-font-smoothing: antialiased;
}

/* ── Page Layout ── */
.page-wrap {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0;
}

section.report-section {
  padding: var(--page-pad);
  border-bottom: var(--border);
}

section.report-section:last-child {
  border-bottom: none;
}

/* ── Confidential Banner ── */
.conf-banner {
  background: var(--blue-900);
  color: var(--white);
  text-align: center;
  padding: 8px 16px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  position: sticky;
  top: 0;
  z-index: 100;
}

/* ── Cover Page ── */
.cover {
  background: var(--white);
  padding: 0;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  border-bottom: none;
}

.cover-hero {
  background: linear-gradient(135deg, var(--blue-900) 0%, var(--blue-700) 55%, var(--blue-400) 100%);
  padding: 72px var(--page-pad) 64px;
  position: relative;
  overflow: hidden;
}

.cover-hero::before {
  content: '';
  position: absolute;
  top: -60px; right: -60px;
  width: 420px; height: 420px;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
  pointer-events: none;
}

.cover-hero::after {
  content: '';
  position: absolute;
  bottom: -100px; left: 30%;
  width: 600px; height: 300px;
  border-radius: 50%;
  background: rgba(255,255,255,0.03);
  pointer-events: none;
}

.cover-logo-line {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 56px;
}

.cover-logo-mark {
  width: 40px; height: 40px;
  background: rgba(255,255,255,0.15);
  border: 1.5px solid rgba(255,255,255,0.3);
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  font-size: 18px; font-weight: 900; color: var(--white);
  letter-spacing: -0.04em;
}

.cover-brand {
  font-size: 13px;
  font-weight: 600;
  color: rgba(255,255,255,0.75);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.cover-title {
  font-size: 42px;
  font-weight: 800;
  color: var(--white);
  line-height: 1.15;
  letter-spacing: -0.02em;
  margin-bottom: 12px;
  max-width: 640px;
}

.cover-subtitle {
  font-size: 17px;
  font-weight: 400;
  color: rgba(255,255,255,0.7);
  margin-bottom: 48px;
}

.cover-meta-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  background: rgba(255,255,255,0.1);
  border-radius: 8px;
  overflow: hidden;
  max-width: 800px;
}

.cover-meta-cell {
  background: rgba(255,255,255,0.06);
  padding: 16px 20px;
}

.cover-meta-label {
  font-size: 10px;
  font-weight: 600;
  color: rgba(255,255,255,0.5);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 4px;
}

.cover-meta-value {
  font-size: 13px;
  font-weight: 600;
  color: var(--white);
}

.cover-body {
  padding: 48px var(--page-pad);
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 40px;
}

.cover-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
  align-items: start;
}

.cover-field-group {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.cover-field {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.cover-field-label {
  font-size: 10px;
  font-weight: 600;
  color: var(--gray-500);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.cover-field-value {
  font-size: 14px;
  font-weight: 500;
  color: var(--gray-900);
}

.cover-field-value.mono {
  font-family: var(--font-mono);
  font-size: 13px;
}

/* Risk + Outcome badges on cover */
.risk-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.risk-badge.critical {
  background: var(--sev-critical-bg);
  color: var(--sev-critical-txt);
  border: 1.5px solid var(--sev-critical-bdr);
}

.risk-badge.critical::before {
  content: '';
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--sev-critical-dot);
  flex-shrink: 0;
}

.outcome-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  border-radius: 6px;
  background: #fff0f0;
  color: #b30e24;
  border: 1.5px solid #e8112d;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.cover-classification {
  margin-top: auto;
  padding-top: 32px;
  border-top: var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.classification-tag {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gray-500);
}

/* ── Typography Utilities ── */
h2.section-title {
  font-size: 22px;
  font-weight: 700;
  color: var(--blue-900);
  margin-bottom: 6px;
  letter-spacing: -0.01em;
}

h3.subsection-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--gray-800);
  margin-bottom: 16px;
}

.section-lead {
  font-size: 14px;
  color: var(--gray-600);
  margin-bottom: 28px;
  max-width: 680px;
  line-height: 1.65;
}

.section-eyebrow {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--blue-400);
  margin-bottom: 8px;
}

.rule {
  width: 40px;
  height: 3px;
  background: var(--blue-400);
  border-radius: 2px;
  margin-bottom: 20px;
}

/* ── Severity Badges ── */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3px 9px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  white-space: nowrap;
}

.badge::before {
  content: '';
  width: 6px; height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
}

.badge.critical { background: var(--sev-critical-bg); color: var(--sev-critical-txt); border: 1px solid var(--sev-critical-bdr); }
.badge.critical::before { background: var(--sev-critical-dot); }
.badge.high     { background: var(--sev-high-bg);     color: var(--sev-high-txt);     border: 1px solid var(--sev-high-bdr); }
.badge.high::before     { background: var(--sev-high-dot); }
.badge.medium   { background: var(--sev-medium-bg);   color: var(--sev-medium-txt);   border: 1px solid var(--sev-medium-bdr); }
.badge.medium::before   { background: var(--sev-medium-dot); }
.badge.low      { background: var(--sev-low-bg);      color: var(--sev-low-txt);      border: 1px solid var(--sev-low-bdr); }
.badge.low::before      { background: var(--sev-low-dot); }
.badge.info     { background: var(--sev-info-bg);     color: var(--sev-info-txt);     border: 1px solid var(--sev-info-bdr); }
.badge.info::before     { background: var(--sev-info-dot); }

/* Outcome badges */
.badge.exploitable { background: #fff0f0; color: #b30e24; border: 1px solid #e8112d; }
.badge.exploitable::before { background: #e8112d; }
.badge.non-exploitable { background: #f0faf3; color: #157339; border: 1px solid #19a34a; }
.badge.non-exploitable::before { background: #19a34a; }
.badge.success { background: var(--blue-50); color: var(--blue-700); border: 1px solid var(--blue-300); }
.badge.success::before { background: var(--blue-400); }
.badge.blocked { background: #fffbea; color: #9c7500; border: 1px solid #d4a017; }
.badge.blocked::before { background: #d4a017; }
.badge.verified { background: #f0faf3; color: #157339; border: 1px solid #19a34a; }
.badge.verified::before { background: #19a34a; }
.badge.open { background: #fff5ed; color: #b84d00; border: 1px solid #e85d04; }
.badge.open::before { background: #e85d04; }
.badge.gated { background: var(--blue-50); color: var(--blue-700); border: 1px solid var(--blue-300); }
.badge.gated::before { background: var(--blue-400); }

/* ── Stat Tiles ── */
.stat-tiles {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12px;
  margin-bottom: 28px;
}

.stat-tile {
  border-radius: var(--card-radius);
  padding: 18px 14px;
  text-align: center;
  border: 1.5px solid;
  background: var(--white);
  break-inside: avoid;
}

.stat-tile .tile-count {
  font-size: 32px;
  font-weight: 800;
  line-height: 1;
  margin-bottom: 4px;
  letter-spacing: -0.03em;
}

.stat-tile .tile-label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.stat-tile.critical { border-color: var(--sev-critical-bdr); }
.stat-tile.critical .tile-count { color: var(--sev-critical-txt); }
.stat-tile.critical .tile-label { color: var(--sev-critical-txt); }

.stat-tile.high { border-color: var(--sev-high-bdr); }
.stat-tile.high .tile-count { color: var(--sev-high-txt); }
.stat-tile.high .tile-label { color: var(--sev-high-txt); }

.stat-tile.medium { border-color: var(--sev-medium-bdr); }
.stat-tile.medium .tile-count { color: var(--sev-medium-txt); }
.stat-tile.medium .tile-label { color: var(--sev-medium-txt); }

.stat-tile.low { border-color: var(--sev-low-bdr); }
.stat-tile.low .tile-count { color: var(--sev-low-txt); }
.stat-tile.low .tile-label { color: var(--sev-low-txt); }

.stat-tile.info { border-color: var(--sev-info-bdr); }
.stat-tile.info .tile-count { color: var(--sev-info-txt); }
.stat-tile.info .tile-label { color: var(--sev-info-txt); }

.stat-tile.total { border-color: var(--gray-300); }
.stat-tile.total .tile-count { color: var(--gray-800); }
.stat-tile.total .tile-label { color: var(--gray-600); }

.stat-tile.access { border-color: var(--sev-critical-bdr); background: var(--sev-critical-bg); }
.stat-tile.access .tile-count { color: var(--sev-critical-txt); font-size: 18px; line-height: 1.4; }
.stat-tile.access .tile-label { color: var(--sev-critical-txt); }

/* ── Cards ── */
.card {
  background: var(--white);
  border: var(--border);
  border-radius: var(--card-radius);
  padding: 24px;
  break-inside: avoid;
}

.card.accent-left {
  border-left: 4px solid var(--blue-400);
}

.card.accent-left.critical { border-left-color: var(--sev-critical-bdr); }
.card.accent-left.high     { border-left-color: var(--sev-high-bdr); }
.card.accent-left.medium   { border-left-color: var(--sev-medium-bdr); }
.card.accent-left.low      { border-left-color: var(--sev-low-bdr); }
.card.accent-left.info     { border-left-color: var(--sev-info-bdr); }

.card-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--gray-900);
  margin-bottom: 8px;
}

.card-subtitle {
  font-size: 12px;
  color: var(--gray-500);
  margin-bottom: 16px;
}

.card-grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.card-grid-3 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20px;
}

/* ── Tables ── */
.report-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

.report-table th {
  background: var(--gray-50);
  color: var(--gray-600);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 10px 14px;
  text-align: left;
  border-bottom: 2px solid var(--gray-200);
  white-space: nowrap;
}

.report-table td {
  padding: 12px 14px;
  border-bottom: 1px solid var(--gray-100);
  vertical-align: middle;
  color: var(--gray-800);
}

.report-table tbody tr:last-child td { border-bottom: none; }

.report-table tbody tr:hover td { background: var(--gray-50); }

.report-table td.mono {
  font-family: var(--font-mono);
  font-size: 11.5px;
  color: var(--gray-700);
}

.table-wrap {
  border: var(--border);
  border-radius: var(--card-radius);
  overflow: hidden;
  break-inside: avoid;
}

/* ── Code / Evidence blocks ── */
.code-block {
  background: var(--gray-950);
  color: #e2e8f0;
  font-family: var(--font-mono);
  font-size: 12px;
  line-height: 1.7;
  padding: 16px 20px;
  border-radius: 6px;
  overflow-x: auto;
  border: 1px solid var(--gray-800);
  margin: 12px 0;
}

.code-block .comment { color: #718096; }
.code-block .cmd     { color: #90cdf4; }
.code-block .path    { color: #9ae6b4; }
.code-block .val     { color: #faf089; }
.code-block .redact  { color: #fc8181; background: rgba(252,129,129,0.1); padding: 0 4px; border-radius: 2px; }

/* ── Info KV pairs ── */
.kv-grid {
  display: grid;
  grid-template-columns: 160px 1fr;
  gap: 8px 16px;
  font-size: 13px;
}

.kv-key {
  font-weight: 600;
  color: var(--gray-600);
  font-size: 11px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding-top: 1px;
}

.kv-val {
  color: var(--gray-900);
}

/* ── Priority Actions ── */
.priority-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.priority-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 14px 16px;
  border-radius: 6px;
  border: 1px solid;
  break-inside: avoid;
}

.priority-item.p1 { border-color: var(--sev-critical-bdr); background: var(--sev-critical-bg); }
.priority-item.p2 { border-color: var(--sev-high-bdr);     background: var(--sev-high-bg); }
.priority-item.p3 { border-color: var(--sev-medium-bdr);   background: var(--sev-medium-bg); }

.priority-pill {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 3px 8px;
  border-radius: 4px;
  white-space: nowrap;
  flex-shrink: 0;
  margin-top: 1px;
}

.p1 .priority-pill { background: var(--sev-critical-bdr); color: white; }
.p2 .priority-pill { background: var(--sev-high-bdr);     color: white; }
.p3 .priority-pill { background: var(--sev-medium-bdr);   color: white; }

.priority-text { font-size: 13px; color: var(--gray-800); line-height: 1.5; }
.priority-text strong { color: var(--gray-900); font-weight: 600; }

/* ── Timeline ── */
.timeline {
  position: relative;
  padding-left: 28px;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 8px; top: 8px; bottom: 8px;
  width: 2px;
  background: var(--gray-200);
  border-radius: 2px;
}

.timeline-item {
  position: relative;
  padding-bottom: 24px;
  break-inside: avoid;
}

.timeline-item:last-child { padding-bottom: 0; }

.timeline-dot {
  position: absolute;
  left: -24px; top: 4px;
  width: 12px; height: 12px;
  border-radius: 50%;
  background: var(--blue-400);
  border: 2px solid var(--white);
  box-shadow: 0 0 0 1px var(--blue-400);
}

.timeline-dot.critical { background: var(--sev-critical-bdr); box-shadow: 0 0 0 1px var(--sev-critical-bdr); }
.timeline-dot.milestone { background: var(--blue-600); box-shadow: 0 0 0 1px var(--blue-600); }

.timeline-time {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--gray-500);
  margin-bottom: 2px;
}

.timeline-label {
  font-size: 13px;
  font-weight: 600;
  color: var(--gray-900);
}

.timeline-note {
  font-size: 12px;
  color: var(--gray-600);
  margin-top: 2px;
}

/* ── Finding Cards (detailed) ── */
.finding-card {
  border: var(--border);
  border-radius: var(--card-radius);
  overflow: hidden;
  margin-bottom: 24px;
  break-inside: avoid;
}

.finding-card-header {
  padding: 18px 24px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  border-bottom: var(--border);
}

.finding-card-header.critical { background: var(--sev-critical-bg); border-bottom-color: var(--sev-critical-bdr); }
.finding-card-header.high     { background: var(--sev-high-bg);     border-bottom-color: var(--sev-high-bdr); }
.finding-card-header.medium   { background: var(--sev-medium-bg);   border-bottom-color: var(--sev-medium-bdr); }
.finding-card-header.low      { background: var(--sev-low-bg);      border-bottom-color: var(--sev-low-bdr); }
.finding-card-header.info     { background: var(--sev-info-bg);     border-bottom-color: var(--sev-info-bdr); }

.finding-card-id {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  color: var(--gray-500);
  margin-bottom: 4px;
}

.finding-card-name {
  font-size: 16px;
  font-weight: 700;
  color: var(--gray-900);
}

.finding-card-meta {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-shrink: 0;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.finding-card-body {
  padding: 20px 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.finding-section-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gray-500);
  margin-bottom: 6px;
}

.finding-text {
  font-size: 13px;
  color: var(--gray-700);
  line-height: 1.65;
}

/* ── Loot card ── */
.loot-card {
  background: var(--gray-950);
  border-radius: 6px;
  overflow: hidden;
  border: 1px solid var(--gray-800);
}

.loot-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 14px;
  background: rgba(255,255,255,0.04);
  border-bottom: 1px solid rgba(255,255,255,0.06);
}

.loot-filename {
  font-family: var(--font-mono);
  font-size: 11px;
  color: #90cdf4;
}

.loot-hash {
  font-family: var(--font-mono);
  font-size: 10px;
  color: #718096;
}

.loot-content {
  padding: 12px 14px;
  font-family: var(--font-mono);
  font-size: 11.5px;
  color: #e2e8f0;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.redacted {
  background: rgba(252,129,129,0.15);
  color: #fc8181;
  padding: 1px 5px;
  border-radius: 3px;
  font-family: var(--font-mono);
  font-size: 11px;
}

/* ── Attack graph SVG wrapper ── */
.svg-wrap {
  border: var(--border);
  border-radius: var(--card-radius);
  overflow: hidden;
  background: var(--gray-50);
}

/* ── MITRE table ── */
.mitre-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}

.mitre-cell {
  border: var(--border);
  border-radius: 6px;
  padding: 14px 16px;
  break-inside: avoid;
}

.mitre-tactic {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--gray-500);
  margin-bottom: 4px;
}

.mitre-id {
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 600;
  color: var(--blue-400);
  margin-bottom: 4px;
}

.mitre-name {
  font-size: 13px;
  font-weight: 600;
  color: var(--gray-900);
}

.mitre-note {
  font-size: 11px;
  color: var(--gray-600);
  margin-top: 4px;
}

/* ── Footer ── */
.report-footer {
  padding: 24px var(--page-pad);
  background: var(--gray-50);
  border-top: 2px solid var(--gray-200);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 11px;
  color: var(--gray-500);
}

.footer-brand {
  font-weight: 700;
  color: var(--gray-700);
  font-size: 12px;
}

/* ── Remediation roadmap ── */
.roadmap-col {
  break-inside: avoid;
}

.roadmap-header {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
  border-radius: 6px 6px 0 0;
  border: 1.5px solid;
  border-bottom: none;
}

.roadmap-header.p1 { background: var(--sev-critical-bg); border-color: var(--sev-critical-bdr); }
.roadmap-header.p2 { background: var(--sev-high-bg);     border-color: var(--sev-high-bdr); }
.roadmap-header.p3 { background: var(--sev-medium-bg);   border-color: var(--sev-medium-bdr); }

.roadmap-priority-label {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.p1 .roadmap-priority-label { color: var(--sev-critical-txt); }
.p2 .roadmap-priority-label { color: var(--sev-high-txt); }
.p3 .roadmap-priority-label { color: var(--sev-medium-txt); }

.roadmap-timeline-tag {
  font-size: 10px;
  font-weight: 600;
  color: var(--gray-500);
  margin-left: auto;
}

.roadmap-body {
  border: 1.5px solid;
  border-top: none;
  border-radius: 0 0 6px 6px;
  padding: 12px 16px;
}

.p1 .roadmap-body { border-color: var(--sev-critical-bdr); }
.p2 .roadmap-body { border-color: var(--sev-high-bdr); }
.p3 .roadmap-body { border-color: var(--sev-medium-bdr); }

.roadmap-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 8px 0;
  border-bottom: 1px solid var(--gray-100);
  font-size: 13px;
  color: var(--gray-800);
}

.roadmap-item:last-child { border-bottom: none; }

.roadmap-bullet {
  width: 20px; height: 20px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 10px; font-weight: 700;
  flex-shrink: 0; margin-top: 1px;
}

.p1 .roadmap-bullet { background: var(--sev-critical-bdr); color: white; }
.p2 .roadmap-bullet { background: var(--sev-high-bdr);     color: white; }
.p3 .roadmap-bullet { background: var(--sev-medium-bdr);   color: white; }

/* ── Detection table ── */
.detect-stage {
  font-weight: 600;
  color: var(--gray-900);
  font-size: 12px;
}

.detect-status {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.detect-status.open    { background: #fff5ed; color: var(--sev-high-txt); border: 1px solid var(--sev-high-bdr); }
.detect-status.partial { background: var(--sev-medium-bg); color: var(--sev-medium-txt); border: 1px solid var(--sev-medium-bdr); }
.detect-status.covered { background: var(--sev-low-bg);  color: var(--sev-low-txt);  border: 1px solid var(--sev-low-bdr); }

/* ── TOC ── */
.toc-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4px 32px;
}

.toc-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1px dotted var(--gray-200);
  font-size: 13px;
  color: var(--gray-700);
}

.toc-item:last-child { border-bottom: none; }

.toc-num {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--gray-400);
  flex-shrink: 0;
  margin-left: 8px;
}

/* ── Inline SVG chart helpers ── */
.chart-wrap {
  border: var(--border);
  border-radius: var(--card-radius);
  padding: 24px;
  background: var(--white);
  break-inside: avoid;
}

.chart-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--gray-800);
  margin-bottom: 16px;
}

/* ── Section header strip ── */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28px;
  padding-bottom: 20px;
  border-bottom: 2px solid var(--gray-100);
}

.section-header-left {}
.section-number {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--blue-400);
  margin-bottom: 4px;
}

/* ── Misc helpers ── */
.mt-4  { margin-top: 4px; }
.mt-8  { margin-top: 8px; }
.mt-12 { margin-top: 12px; }
.mt-16 { margin-top: 16px; }
.mt-24 { margin-top: 24px; }
.mt-32 { margin-top: 32px; }
.mb-8  { margin-bottom: 8px; }
.mb-16 { margin-bottom: 16px; }
.mb-24 { margin-bottom: 24px; }
.mb-32 { margin-bottom: 32px; }
.flex  { display: flex; }
.flex-wrap { flex-wrap: wrap; }
.gap-8 { gap: 8px; }
.gap-12 { gap: 12px; }
.gap-16 { gap: 16px; }
.gap-20 { gap: 20px; }
.items-center { align-items: center; }
.justify-between { justify-content: space-between; }
.text-mono { font-family: var(--font-mono); font-size: 11.5px; }
.text-sm { font-size: 12px; }
.text-xs { font-size: 11px; }
.color-muted { color: var(--gray-500); }
.font-600 { font-weight: 600; }
.font-700 { font-weight: 700; }

/* ── Page-break helpers ── */
.page-break-before { page-break-before: always; break-before: page; }
.no-break { break-inside: avoid; page-break-inside: avoid; }

/* ============================================================
   PRINT STYLES
   ============================================================ */
@page {
  size: A4;
  margin: 16mm 14mm 18mm 14mm;
  @bottom-right {
    content: "{{ target_display }} — CONFIDENTIAL — Page " counter(page) " of " counter(pages);
    font-size: 8pt;
    color: #838799;
    font-family: Inter, sans-serif;
  }
  @bottom-left {
    content: "ARGUS Security Assessment · {{ target_display }} · {{ generated_at }}";
    font-size: 8pt;
    color: #838799;
    font-family: Inter, sans-serif;
  }
}

@media print {
  .conf-banner { position: static; }
  .cover { min-height: auto; page-break-after: always; break-after: page; }
  .cover-hero { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .finding-card-header { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .stat-tile { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .priority-item { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .roadmap-header { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .badge { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .loot-card { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .code-block { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  section.report-section { page-break-inside: avoid; }
  .finding-card { page-break-inside: avoid; }
  .table-wrap { page-break-inside: avoid; }
  .no-break { page-break-inside: avoid; }
  html { font-size: 12px; }
  body { background: white; }
  .report-footer { display: none; }
}
</style>
</head>
<body>

<!-- ══════════════════════════════════════════════════════════
     CONFIDENTIAL BANNER
     ══════════════════════════════════════════════════════════ -->
<div class="conf-banner">CONFIDENTIAL — CLIENT PRIVILEGED &nbsp;·&nbsp; ARGUS Security Assessment &nbsp;·&nbsp; {{ target_display }} &nbsp;·&nbsp; {{ generated_at }}</div>

<!-- ══════════════════════════════════════════════════════════
     SECTION 0 — COVER PAGE
     ══════════════════════════════════════════════════════════ -->
<div class="page-wrap">
<section class="cover report-section">

  <div class="cover-hero">
    <div class="cover-logo-line">
      <div class="cover-logo-mark">A</div>
      <span class="cover-brand">ARGUS Security · Autonomous Pentesting Engine</span>
    </div>

    <div class="cover-title">Penetration Test<br>Assessment Report</div>
    <div class="cover-subtitle">{{ engagement_type }}</div>

    <div class="cover-meta-grid">
      <div class="cover-meta-cell">
        <div class="cover-meta-label">Target</div>
        <div class="cover-meta-value">{{ target_display }}</div>
      </div>
      {% if session %}
      <div class="cover-meta-cell">
        <div class="cover-meta-label">IP / Host</div>
        <div class="cover-meta-value">{{ session.target_ip }}{% if session.target_hostname %} "{{ session.target_hostname }}"{% endif %}</div>
      </div>
      <div class="cover-meta-cell">
        <div class="cover-meta-label">Engagement Window</div>
        <div class="cover-meta-value">{{ session.started_at }}{% if session.completed_at %} → {{ session.completed_at }}{% endif %}</div>
      </div>
      {% endif %}
      <div class="cover-meta-cell">
        <div class="cover-meta-label">Report Date</div>
        <div class="cover-meta-value">{{ generated_at }}</div>
      </div>
    </div>
  </div>

  <div class="cover-body">
    <div class="cover-row">
      <div class="cover-field-group">
        <div class="cover-field">
          <span class="cover-field-label">Assessment Type</span>
          <span class="cover-field-value">{{ engagement_type }}</span>
        </div>
        {% if session %}
        <div class="cover-field">
          <span class="cover-field-label">Scope</span>
          <span class="cover-field-value">{{ session.scope }}</span>
        </div>
        <div class="cover-field">
          <span class="cover-field-label">Target</span>
          <span class="cover-field-value mono">{{ session.target_hostname }} · {{ session.target_ip }}{% if intel and intel.os_guess %} · {{ intel.os_guess }}{% endif %}</span>
        </div>
        {% endif %}
        <div class="cover-field">
          <span class="cover-field-label">Analysts</span>
          <span class="cover-field-value">ARGUS Autonomous Engine (operator-reviewed)</span>
        </div>
        <div class="cover-field">
          <span class="cover-field-label">Classification</span>
          <span class="cover-field-value">CONFIDENTIAL — Client Privileged</span>
        </div>
        {% if duration %}
        <div class="cover-field">
          <span class="cover-field-label">Duration</span>
          <span class="cover-field-value">{{ duration }}</span>
        </div>
        {% endif %}
      </div>

      <div class="cover-field-group">
        {% if outcome %}
        <div class="cover-field">
          <span class="cover-field-label">Overall Risk</span>
          <div class="mt-4">
            <span class="risk-badge critical">Critical</span>
          </div>
        </div>
        <div class="cover-field">
          <span class="cover-field-label">Outcome</span>
          <div class="mt-4">
            <span class="outcome-badge">{{ outcome.label }}</span>
          </div>
        </div>
        {% endif %}
        {% if executive_summary %}
        <div class="cover-field mt-8">
          <span class="cover-field-label">Executive Summary</span>
          <span class="cover-field-value" style="font-size:13px;line-height:1.6;color:var(--gray-700);">{{ executive_summary }}</span>
        </div>
        {% endif %}
      </div>
    </div>

    <div class="cover-classification">
      <span class="classification-tag">CONFIDENTIAL — CLIENT PRIVILEGED · ARGUS SECURITY ASSESSMENT</span>
      <span class="classification-tag">{{ target_display }} · {{ generated_at }}</span>
    </div>
  </div>

</section>

<!-- ══════════════════════════════════════════════════════════
     SECTION 1 — DOCUMENT CONTROL & TABLE OF CONTENTS
     ══════════════════════════════════════════════════════════ -->
<section class="report-section">
  <div class="section-header">
    <div class="section-header-left">
      <div class="section-number">Section 1</div>
      <h2 class="section-title">Document Control &amp; Contents</h2>
    </div>
  </div>

  <h3 class="subsection-title">Document Control</h3>
  <div class="table-wrap mb-32">
    <table class="report-table">
      <thead>
        <tr><th>Field</th><th>Detail</th></tr>
      </thead>
      <tbody>
        <tr><td class="font-600">Document Title</td><td>ARGUS Security Assessment — Penetration Test Report</td></tr>
        <tr><td class="font-600">Version</td><td>1.0 — Final</td></tr>
        <tr><td class="font-600">Classification</td><td><strong>CONFIDENTIAL — Client Privileged</strong></td></tr>
        {% if session %}
        <tr><td class="font-600">Target System</td><td class="mono">{{ session.target_ip }}{% if session.target_hostname %} "{{ session.target_hostname }}"{% endif %}{% if intel and intel.os_guess %} · {{ intel.os_guess }}{% endif %}</td></tr>
        <tr><td class="font-600">Scope</td><td>{{ session.scope }}</td></tr>
        <tr><td class="font-600">Engagement Window</td><td>{{ session.started_at }}{% if session.completed_at %} → {{ session.completed_at }}{% endif %}</td></tr>
        {% endif %}
        <tr><td class="font-600">Assessment Engine</td><td>ARGUS Autonomous Pentesting Engine (operator-reviewed)</td></tr>
        <tr><td class="font-600">Report Generated</td><td class="mono">{{ generated_at }}</td></tr>
        <tr><td class="font-600">Distribution</td><td>Authorised recipient only — do not forward or copy without written consent</td></tr>
      </tbody>
    </table>
  </div>

  <h3 class="subsection-title">Table of Contents</h3>
  <div class="toc-grid">
    <div>
      <div class="toc-item"><span>1 · Document Control &amp; Contents</span><span class="toc-num">this page</span></div>
      <div class="toc-item"><span>2 · Executive Summary</span><span class="toc-num">§2</span></div>
      <div class="toc-item"><span>3 · System &amp; Scope</span><span class="toc-num">§3</span></div>
      <div class="toc-item"><span>4 · Methodology &amp; CVSS Rubric</span><span class="toc-num">§4</span></div>
      <div class="toc-item"><span>5 · Attack-Path / Kill-Chain Graph</span><span class="toc-num">§5</span></div>
      <div class="toc-item"><span>6 · Attacks Attempted Coverage Log</span><span class="toc-num">§6</span></div>
      <div class="toc-item"><span>7 · Findings Register</span><span class="toc-num">§7</span></div>
    </div>
    <div>
      <div class="toc-item"><span>8 · Detailed Finding Cards</span><span class="toc-num">§8</span></div>
      <div class="toc-item"><span>9 · Tested — Not Exploitable</span><span class="toc-num">§9</span></div>
      <div class="toc-item"><span>10 · Detection / Purple-Team Mapping</span><span class="toc-num">§10</span></div>
      <div class="toc-item"><span>11 · Evidence Appendix &amp; Captured Loot</span><span class="toc-num">§11</span></div>
      <div class="toc-item"><span>12 · MITRE ATT&amp;CK Map</span><span class="toc-num">§12</span></div>
      <div class="toc-item"><span>13 · Remediation Roadmap</span><span class="toc-num">§13</span></div>
      <div class="toc-item"><span>14 · Engagement Timeline &amp; Data Visualisation</span><span class="toc-num">§14</span></div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════════
     SECTION 2 — EXECUTIVE SUMMARY
     ══════════════════════════════════════════════════════════ -->
<section class="report-section">
  <div class="section-header">
    <div class="section-header-left">
      <div class="section-number">Section 2</div>
      <h2 class="section-title">Executive Summary</h2>
    </div>
    <span class="risk-badge critical">Overall Risk: Critical</span>
  </div>

  {% if executive_summary %}
  <div class="card accent-left critical mb-24 no-break">
    <div class="card-title" style="font-size:15px;margin-bottom:12px;">Key Finding</div>
    <p style="font-size:14px;line-height:1.7;color:var(--gray-700);">{{ executive_summary }}</p>
  </div>
  {% endif %}

  <!-- Stat Tiles -->
  <div class="stat-tiles">
    <div class="stat-tile critical">
      <div class="tile-count">{{ summary.critical }}</div>
      <div class="tile-label">Critical</div>
    </div>
    <div class="stat-tile high">
      <div class="tile-count">{{ summary.high }}</div>
      <div class="tile-label">High</div>
    </div>
    <div class="stat-tile medium">
      <div class="tile-count">{{ summary.medium }}</div>
      <div class="tile-label">Medium</div>
    </div>
    <div class="stat-tile low">
      <div class="tile-count">{{ summary.low }}</div>
      <div class="tile-label">Low</div>
    </div>
    <div class="stat-tile info">
      <div class="tile-count">{{ summary.info }}</div>
      <div class="tile-label">Info</div>
    </div>
    <div class="stat-tile total">
      <div class="tile-count">{{ summary.total }}</div>
      <div class="tile-label">Total</div>
    </div>
    {% if outcome %}
    <div class="stat-tile access">
      <div class="tile-count">{% if outcome.root %}ROOT{% elif outcome.compromised %}USER{% else %}—{% endif %}</div>
      <div class="tile-label">Access</div>
    </div>
    {% endif %}
  </div>

  <!-- Priority Actions derived from critical/high findings -->
  {% if findings %}
  <h3 class="subsection-title">Priority Actions</h3>
  <div class="priority-list">
    {% for f in findings %}
    {% if f.severity|lower == 'critical' %}
    <div class="priority-item p1 no-break">
      <span class="priority-pill">P1 — Immediate</span>
      <span class="priority-text"><strong>{{ f.title }}</strong>{% if f.remediation %} — {{ f.remediation }}{% endif %}</span>
    </div>
    {% elif f.severity|lower == 'high' %}
    <div class="priority-item p2 no-break">
      <span class="priority-pill">P2 — 30 days</span>
      <span class="priority-text"><strong>{{ f.title }}</strong>{% if f.remediation %} — {{ f.remediation }}{% endif %}</span>
    </div>
    {% elif f.severity|lower == 'medium' %}
    <div class="priority-item p3 no-break">
      <span class="priority-pill">P3 — 90 days</span>
      <span class="priority-text"><strong>{{ f.title }}</strong>{% if f.remediation %} — {{ f.remediation }}{% endif %}</span>
    </div>
    {% endif %}
    {% endfor %}
  </div>
  {% endif %}
</section>

<!-- ══════════════════════════════════════════════════════════
     SECTION 3 — SYSTEM & SCOPE
     ══════════════════════════════════════════════════════════ -->
<section class="report-section">
  <div class="section-header">
    <div class="section-header-left">
      <div class="section-number">Section 3</div>
      <h2 class="section-title">System &amp; Scope</h2>
    </div>
  </div>

  <div class="card-grid-2 mb-24">
    <!-- Target card -->
    {% if session %}
    <div class="card no-break">
      <div class="card-title">Target System</div>
      <div class="card-subtitle">Primary host under assessment</div>
      <div class="kv-grid">
        {% if session.target_hostname %}<span class="kv-key">Hostname</span>     <span class="kv-val mono">{{ session.target_hostname }}</span>{% endif %}
        <span class="kv-key">IP Address</span>   <span class="kv-val mono">{{ session.target_ip }}</span>
        {% if intel and intel.os_guess %}<span class="kv-key">OS</span>           <span class="kv-val">{{ intel.os_guess }}</span>{% endif %}
        <span class="kv-key">Engagement</span>  <span class="kv-val">{{ engagement_type }}</span>
        {% if session.scope %}<span class="kv-key">Scope</span>       <span class="kv-val">{{ session.scope }}</span>{% endif %}
        {% if session.started_at %}<span class="kv-key">Window</span>      <span class="kv-val">{{ session.started_at }}{% if session.completed_at %} → {{ session.completed_at }}{% endif %}</span>{% endif %}
      </div>
    </div>
    {% endif %}

    <!-- Intel / shell access card -->
    {% if intel %}
    <div class="card accent-left critical no-break">
      <div class="card-title">Reconnaissance Intel</div>
      <div class="card-subtitle">Discovered during engagement</div>
      <div class="kv-grid">
        {% if intel.os_guess %}<span class="kv-key">OS Guess</span>     <span class="kv-val">{{ intel.os_guess }}</span>{% endif %}
        {% if intel.open_ports %}<span class="kv-key">Open Ports</span>   <span class="kv-val mono">{% for p in intel.open_ports %}{{ p }}{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}
        {% if intel.shell_access %}<span class="kv-key">Shell Access</span> <span class="kv-val">{{ intel.shell_access }}</span>{% endif %}
      </div>
    </div>
    {% endif %}
  </div>

  <!-- Services table -->
  {% if intel and intel.services %}
  <h3 class="subsection-title">Discovered Services</h3>
  <div class="table-wrap mb-24">
    <table class="report-table">
      <thead>
        <tr>
          <th>Port</th>
          <th>Service</th>
          <th>Version</th>
        </tr>
      </thead>
      <tbody>
        {% for port, s in intel.services.items() %}
        <tr>
          <td class="mono">{{ port }}</td>
          <td class="font-600">{{ s.service }}</td>
          <td>{{ s.version }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <!-- Scope statement -->
  {% if session and session.scope %}
  <h3 class="subsection-title">Scope Statement</h3>
  <div class="card no-break">
    <div class="kv-grid">
      <span class="kv-key">Target</span>
      <span class="kv-val">{{ session.target }}{% if session.target_ip %} ({{ session.target_ip }}){% endif %}</span>
      <span class="kv-key">Scope</span>
      <span class="kv-val">{{ session.scope }}</span>
      <span class="kv-key">Authorisation</span>
      <span class="kv-val">Written authorisation on file; assessment conducted in isolated lab environment</span>
    </div>
  </div>
  {% endif %}
</section>

<!-- ══════════════════════════════════════════════════════════
     SECTION 4 — METHODOLOGY & CVSS RUBRIC
     ══════════════════════════════════════════════════════════ -->
<section class="report-section">
  <div class="section-header">
    <div class="section-header-left">
      <div class="section-number">Section 4</div>
      <h2 class="section-title">Methodology &amp; CVSS Rubric</h2>
    </div>
  </div>

  <p class="section-lead">ARGUS follows a structured <strong>Plan → Execute → Validate</strong> methodology over a hypothesis tree. Every action is annotated with its MITRE ATT&amp;CK technique and linked to a concrete evidence artefact. A finding is only shipped when it passes the ARGUS Issue-Validator gate — requiring a reproducible, tool-evidenced attack path.</p>

  <div class="card-grid-3 mb-24">
    <div class="card no-break" style="border-top:3px solid var(--blue-400);">
      <div class="card-title">1 · Plan</div>
      <p class="finding-text">Surface mapping, hypothesis generation, tool selection. Scope constraints loaded; prior knowledge graph seeded from nmap / banner grabs.</p>
    </div>
    <div class="card no-break" style="border-top:3px solid var(--blue-500);">
      <div class="card-title">2 · Execute</div>
      <p class="finding-text">Ordered tool dispatch against each hypothesis. Every action is logged with timestamp, tool invocation, raw output digest, and MITRE annotation. Non-exploitable paths are recorded as coverage evidence.</p>
    </div>
    <div class="card no-break" style="border-top:3px solid var(--blue-600);">
      <div class="card-title">3 · Validate</div>
      <p class="finding-text">Issue-Validator gate requires: reproducible PoC, concrete tool evidence, accurate CVSS scoring, and retest scheduling. Findings not meeting the bar are demoted to informational.</p>
    </div>
  </div>

  <h3 class="subsection-title">CVSS v3.1 Severity Bands</h3>
  <div class="table-wrap mb-16">
    <table class="report-table">
      <thead>
        <tr>
          <th>Severity</th>
          <th>CVSS Score Range</th>
          <th>Response Expectation</th>
          <th>Example</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><span class="badge critical">Critical</span></td>
          <td class="mono">9.0 – 10.0</td>
          <td>Immediate remediation; escalate to CISO</td>
          <td>Unauth RCE, SSRF to internal admin</td>
        </tr>
        <tr>
          <td><span class="badge high">High</span></td>
          <td class="mono">7.0 – 8.9</td>
          <td>Patch within 30 days; track weekly</td>
          <td>Privilege escalation, critical CVEs</td>
        </tr>
        <tr>
          <td><span class="badge medium">Medium</span></td>
          <td class="mono">4.0 – 6.9</td>
          <td>Remediate within 90 days</td>
          <td>Reflected XSS, missing security headers</td>
        </tr>
        <tr>
          <td><span class="badge low">Low</span></td>
          <td class="mono">0.1 – 3.9</td>
          <td>Address in next maintenance cycle</td>
          <td>Legacy TLS, verbose banners</td>
        </tr>
        <tr>
          <td><span class="badge info">Info</span></td>
          <td class="mono">0.0</td>
          <td>Best-practice hardening; no urgency</td>
          <td>Banner disclosure, config observations</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="flex gap-8 flex-wrap items-center mt-12">
    <span class="text-xs color-muted font-600" style="letter-spacing:0.06em;text-transform:uppercase;">Severity Legend:</span>
    <span class="badge critical">Critical</span>
    <span class="badge high">High</span>
    <span class="badge medium">Medium</span>
    <span class="badge low">Low</span>
    <span class="badge info">Info</span>
    <span style="margin-left:16px;" class="text-xs color-muted font-600" style="letter-spacing:0.06em;text-transform:uppercase;">Outcomes:</span>
    <span class="badge exploitable">Exploitable</span>
    <span class="badge non-exploitable">Non-Exploitable</span>
    <span class="badge blocked">Blocked</span>
    <span class="badge success">Success</span>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════════
     SECTION 5 — ATTACK-PATH / KILL-CHAIN GRAPH
     ══════════════════════════════════════════════════════════ -->
<section class="report-section page-break-before">
  <div class="section-header">
    <div class="section-header-left">
      <div class="section-number">Section 5</div>
      <h2 class="section-title">Attack-Path &amp; Kill-Chain Graph</h2>
    </div>
  </div>
  <p class="section-lead">The graph below traces every hop from initial external access to full compromise. Each node is colour-coded by severity; arrows show causal dependency. MITRE technique IDs annotate each stage.</p>

  {% if attack_path %}
  <div class="svg-wrap">
    {%- set ns = namespace(node_count = attack_path|length) -%}
    {%- set spacing = [140, (900 // (ns.node_count + 1))]|min -%}
    {%- set svg_w = (ns.node_count * spacing) + 100 -%}
    <svg viewBox="0 0 {{ svg_w }} 260" xmlns="http://www.w3.org/2000/svg" style="width:100%;display:block;font-family:Inter,sans-serif;">
      <defs>
        <marker id="arr-red"    markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto"><polygon points="0 0,8 3,0 6" fill="#e8112d"/></marker>
        <marker id="arr-orange" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto"><polygon points="0 0,8 3,0 6" fill="#e85d04"/></marker>
        <marker id="arr-blue"   markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto"><polygon points="0 0,8 3,0 6" fill="#0b66c3"/></marker>
        <filter id="glow-red" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur in="SourceAlpha" stdDeviation="3" result="blur"/>
          <feFlood flood-color="#e8112d" flood-opacity="0.3" result="color"/>
          <feComposite in="color" in2="blur" operator="in" result="shadow"/>
          <feMerge><feMergeNode in="shadow"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
        <filter id="glow-blue" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur in="SourceAlpha" stdDeviation="2" result="blur"/>
          <feFlood flood-color="#0b66c3" flood-opacity="0.25" result="color"/>
          <feComposite in="color" in2="blur" operator="in" result="shadow"/>
          <feMerge><feMergeNode in="shadow"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
      </defs>
      <rect width="{{ svg_w }}" height="260" fill="#f8f9fc" rx="8"/>
      {% for s in attack_path %}
        {%- set cx = (loop.index0 * spacing) + 60 -%}
        {%- set cy = 100 -%}
        {%- set phase_lower = s.phase|lower -%}
        {%- if 'root' in phase_lower or 'compromise' in phase_lower or 'rce' in phase_lower -%}
          {%- set fill = '#e8112d' -%}{%- set stroke = '#b30e24' -%}{%- set txt = 'white' -%}
        {%- elif 'privesc' in phase_lower or 'escalat' in phase_lower -%}
          {%- set fill = '#e85d04' -%}{%- set stroke = '#b84d00' -%}{%- set txt = 'white' -%}
        {%- elif 'recon' in phase_lower or 'scan' in phase_lower -%}
          {%- set fill = '#f0f7fd' -%}{%- set stroke = '#0b66c3' -%}{%- set txt = '#0b2044' -%}
        {%- else -%}
          {%- set fill = '#fff5ed' -%}{%- set stroke = '#e85d04' -%}{%- set txt = '#b84d00' -%}
        {%- endif -%}
        <g>
          <rect x="{{ cx - 55 }}" y="{{ cy - 36 }}" width="110" height="72" rx="8" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="1.5"/>
          <text x="{{ cx }}" y="{{ cy - 14 }}" text-anchor="middle" font-size="10" font-weight="700" fill="{{ txt }}">{{ s.phase|truncate(16, True, '') }}</text>
          <text x="{{ cx }}" y="{{ cy + 2 }}" text-anchor="middle" font-size="9" fill="{{ txt }}" opacity="0.85">{{ s.result|truncate(18, True, '') }}</text>
          {% if s.source %}<text x="{{ cx }}" y="{{ cy + 17 }}" text-anchor="middle" font-size="8" fill="{{ txt }}" opacity="0.7">{{ s.source|truncate(18, True, '') }}</text>{% endif %}
        </g>
        {% if not loop.last %}
        <line x1="{{ cx + 56 }}" y1="{{ cy }}" x2="{{ cx + spacing - 56 }}" y2="{{ cy }}" stroke="#e8112d" stroke-width="2" marker-end="url(#arr-red)"/>
        {% endif %}
      {% endfor %}
      <!-- Legend -->
      <rect x="{{ svg_w - 180 }}" y="180" width="165" height="64" rx="6" fill="white" stroke="#e2e4ec" stroke-width="1"/>
      <text x="{{ svg_w - 165 }}" y="198" font-size="9" font-weight="700" fill="#474c62" letter-spacing="0.08em">LEGEND</text>
      <rect x="{{ svg_w - 165 }}" y="206" width="12" height="12" rx="2" fill="#e8112d"/>
      <text x="{{ svg_w - 149 }}" y="216" font-size="9" fill="#2d3142">Critical / exploited</text>
      <rect x="{{ svg_w - 165 }}" y="223" width="12" height="12" rx="2" fill="#e85d04"/>
      <text x="{{ svg_w - 149 }}" y="233" font-size="9" fill="#2d3142">High severity</text>
      <rect x="{{ svg_w - 70 }}" y="206" width="12" height="12" rx="2" fill="#f0f7fd" stroke="#0b66c3" stroke-width="1"/>
      <text x="{{ svg_w - 54 }}" y="216" font-size="9" fill="#2d3142">Recon / info</text>
      <line x1="{{ svg_w - 70 }}" y1="229" x2="{{ svg_w - 58 }}" y2="229" stroke="#e8112d" stroke-width="2" marker-end="url(#arr-red)"/>
      <text x="{{ svg_w - 54 }}" y="233" font-size="9" fill="#2d3142">Attack path</text>
    </svg>
  </div>

  <!-- Kill-Chain Narrative table -->
  <div class="mt-16 card no-break">
    <div class="card-title mb-8">Kill-Chain Narrative</div>
    <div class="kv-grid" style="grid-template-columns:90px 1fr;">
      {% for s in attack_path %}
      <span class="kv-key">Step {{ loop.index }}</span>
      <span class="kv-val"><strong>{{ s.phase }}</strong>{% if s.result %} — {{ s.result }}{% endif %}{% if s.source %} <span class="text-mono color-muted">({{ s.source }})</span>{% endif %}</span>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <div class="card no-break" style="background:var(--gray-50);">
    <p class="finding-text color-muted">No attack path data available for this engagement.</p>
  </div>
  {% endif %}
</section>

<!-- ══════════════════════════════════════════════════════════
     SECTION 6 — ATTACKS ATTEMPTED COVERAGE LOG
     ══════════════════════════════════════════════════════════ -->
<section class="report-section">
  <div class="section-header">
    <div class="section-header-left">
      <div class="section-number">Section 6</div>
      <h2 class="section-title">Attacks Attempted — Coverage Log</h2>
    </div>
  </div>
  <p class="section-lead">All attack attempts — successful and unsuccessful — are logged below for full coverage transparency. Non-exploitable results are retained as evidence that the attack surface was thoroughly exercised.</p>

  {% if coverage_tests %}
  <div class="table-wrap">
    <table class="report-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Attack / Tool</th>
          <th>Command</th>
          <th>Outcome</th>
          <th>Notes</th>
        </tr>
      </thead>
      <tbody>
        {% for c in coverage_tests %}
        {%- set oc = c.outcome|lower -%}
        {%- if oc == 'success' or oc == 'exploitable' -%}
          {%- set row_bg = 'background:var(--sev-critical-bg);' -%}
        {%- elif oc == 'negative' or oc == 'blocked' or oc == 'error' -%}
          {%- set row_bg = 'background:var(--sev-low-bg);' -%}
        {%- else -%}
          {%- set row_bg = '' -%}
        {%- endif -%}
        <tr style="{{ row_bg }}">
          <td class="mono color-muted">{{ '%02d'|format(loop.index) }}</td>
          <td class="font-600">{{ c.tool }}</td>
          <td class="mono" style="font-size:11px;max-width:260px;word-break:break-all;">{{ c.command }}</td>
          <td>
            {% if oc == 'success' %}<span class="badge success">Success</span>
            {% elif oc == 'exploitable' %}<span class="badge exploitable">Exploitable</span>
            {% elif oc == 'negative' %}<span class="badge non-exploitable">Negative</span>
            {% elif oc == 'blocked' %}<span class="badge blocked">Blocked</span>
            {% elif oc == 'error' %}<span class="badge blocked">Error</span>
            {% else %}<span class="badge info">{{ c.outcome }}</span>
            {% endif %}
          </td>
          <td>{{ c.note }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <div class="card no-break" style="background:var(--gray-50);">
    <p class="finding-text color-muted">No coverage log data available for this engagement.</p>
  </div>
  {% endif %}
</section>

<!-- ══════════════════════════════════════════════════════════
     SECTION 7 — FINDINGS REGISTER
     ══════════════════════════════════════════════════════════ -->
<section class="report-section page-break-before">
  <div class="section-header">
    <div class="section-header-left">
      <div class="section-number">Section 7</div>
      <h2 class="section-title">Findings Register</h2>
    </div>
  </div>
  <p class="section-lead">{% if findings %}All {{ findings|length }} finding{% if findings|length != 1 %}s{% endif %} from this engagement are listed below in severity order.{% else %}No findings have been recorded for this engagement.{% endif %} Each finding references its detailed card in Section 8 and its MITRE ATT&amp;CK technique.</p>

  <div class="flex gap-8 flex-wrap items-center mb-16">
    <span class="text-xs color-muted font-600" style="letter-spacing:0.06em;text-transform:uppercase;">Severity:</span>
    <span class="badge critical">Critical</span>
    <span class="badge high">High</span>
    <span class="badge medium">Medium</span>
    <span class="badge low">Low</span>
    <span class="badge info">Info</span>
    <span style="margin-left:16px;" class="text-xs color-muted font-600" style="letter-spacing:0.06em;text-transform:uppercase;">Retest:</span>
    <span class="badge verified">Verified</span>
    <span class="badge open">Open</span>
    <span class="badge gated">Gated</span>
  </div>

  {% if findings %}
  <div class="table-wrap">
    <table class="report-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Finding</th>
          <th>Severity</th>
          <th>CVSS</th>
          <th>Host / Port</th>
          <th>MITRE</th>
          <th>Retest</th>
        </tr>
      </thead>
      <tbody>
        {% for f in findings %}
        {%- set sev = f.severity|lower -%}
        {%- if sev == 'critical' -%}{%- set row_bg = 'background:var(--sev-critical-bg);' -%}
        {%- elif sev == 'high' -%}{%- set row_bg = 'background:var(--sev-high-bg);' -%}
        {%- else -%}{%- set row_bg = '' -%}
        {%- endif -%}
        <tr style="{{ row_bg }}">
          <td class="mono font-600" style="color:var(--sev-{{ sev }}-txt);">{{ f.fid | default('F-%02d'|format(loop.index)) }}</td>
          <td class="font-600">{{ f.title }}</td>
          <td><span class="badge {{ sev }}">{{ f.severity }}</span></td>
          <td class="mono font-600" style="color:var(--sev-{{ sev }}-txt);">{% if f.extra and f.extra.cvss_base %}{{ f.extra.cvss_base }}{% else %}—{% endif %}</td>
          <td class="mono">{{ f.host }}{% if f.port %}:{{ f.port }}{% endif %}</td>
          <td class="mono" style="color:var(--blue-400);">{% if f.mitre %}{{ f.mitre }}{% else %}—{% endif %}</td>
          <td>
            {%- set rs = f.retest_status|lower if f.retest_status else '' -%}
            {% if rs == 'verified' %}<span class="badge verified">Verified</span>
            {% elif rs == 'open' %}<span class="badge open">Open</span>
            {% elif rs == 'gated' %}<span class="badge gated">Gated</span>
            {% else %}<span class="badge info">{{ f.retest_status or 'Open' }}</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</section>

<!-- ══════════════════════════════════════════════════════════
     SECTION 8 — DETAILED FINDING CARDS
     ══════════════════════════════════════════════════════════ -->
<section class="report-section page-break-before">
  <div class="section-header">
    <div class="section-header-left">
      <div class="section-number">Section 8</div>
      <h2 class="section-title">Detailed Finding Cards</h2>
    </div>
  </div>
  <p class="section-lead">Each card below provides a full technical description, business impact, evidence chain, and specific remediation guidance.</p>

  {% if findings %}
  {% for f in findings %}
  {%- set sev = f.severity|lower -%}
  {%- set fid = f.fid | default('F-' ~ '%02d'|format(loop.index)) -%}
  <div class="finding-card no-break">
    <div class="finding-card-header {{ sev }}">
      <div>
        <div class="finding-card-id">{{ fid }}{% if f.extra and f.extra.cvss_base %} · CVSS {{ f.extra.cvss_base }}{% if f.extra.cvss_vector %} ({{ f.extra.cvss_vector }}){% endif %}{% endif %}</div>
        <div class="finding-card-name">{{ f.title }}</div>
        {%- set _basis = f.severity_rationale if f.severity_rationale else (f.extra.severity_rationale if f.extra and f.extra.severity_rationale else '') -%}
        {% if _basis %}<div class="finding-card-basis" style="font-size:7.5pt;color:#5b6470;margin-top:2px;">Severity basis: {{ _basis }}</div>{% endif %}
      </div>
      <div class="finding-card-meta">
        <span class="badge {{ sev }}">{{ f.severity }}</span>
        {%- set _etag = f.evidence_tag if f.evidence_tag else (f.extra.evidence_tag if f.extra and f.extra.evidence_tag else '') -%}
        {% if _etag %}<span class="badge info" title="What ARGUS established">{{ _etag }}</span>{% endif %}
        {%- set _bv = f.browser_verified if f.browser_verified is defined else (f.extra.browser_verified if f.extra else none) -%}
        {% if _bv == true %}<span style="padding:1px 6px;border-radius:4px;font-size:7pt;font-weight:700;background:#e8f7ee;color:#157339;border:1px solid #19a34a;" title="Confirmed by a real headless browser">BROWSER-VERIFIED</span>
        {% elif _bv == false %}<span style="padding:1px 6px;border-radius:4px;font-size:7pt;font-weight:700;background:#fff4e5;color:#9a6700;border:1px solid #d29922;" title="A browser could not confirm this — needs manual review">UNVERIFIED</span>{% endif %}
        {%- set _rps = f.reproduce_status if f.reproduce_status is defined else (f.extra.reproduce_status if f.extra else none) -%}
        {% if _bv is none and _rps == 'reproduced' %}<span style="padding:1px 6px;border-radius:4px;font-size:7pt;font-weight:700;background:#e8f7ee;color:#157339;border:1px solid #19a34a;" title="Independently reproduced on a separate path">REPRODUCED</span>
        {% elif _bv is none and _rps == 'unreproduced' %}<span style="padding:1px 6px;border-radius:4px;font-size:7pt;font-weight:700;background:#fff4e5;color:#9a6700;border:1px solid #d29922;" title="High/critical claim not independently reproduced">UNREPRODUCED</span>{% endif %}
        {%- set rs = f.retest_status|lower if f.retest_status else '' -%}
        {% if rs == 'verified' %}<span class="badge verified">Verified</span>
        {% elif rs == 'open' %}<span class="badge open">Open</span>
        {% elif rs == 'gated' %}<span class="badge gated">Gated</span>
        {% elif f.retest_status %}<span class="badge info">{{ f.retest_status }}</span>{% endif %}
        {% if f.mitre %}<span class="badge info">{{ f.mitre }}</span>{% endif %}
      </div>
    </div>
    <div class="finding-card-body">
      {% if f.description %}
      <div class="no-break">
        <div class="finding-section-label">Description</div>
        <p class="finding-text">{{ f.description }}</p>
      </div>
      {% endif %}

      <div class="no-break">
        <div class="finding-section-label">Metadata</div>
        <div class="kv-grid" style="grid-template-columns:120px 1fr;">
          <span class="kv-key">Host</span><span class="kv-val mono">{{ f.host }}{% if f.port %}:{{ f.port }}{% endif %}</span>
          {% if f.mitre %}<span class="kv-key">MITRE</span><span class="kv-val mono">{{ f.mitre }}</span>{% endif %}
          {% if f.cves and f.cves|length > 0 %}<span class="kv-key">CVEs</span><span class="kv-val mono">{{ f.cves|join(', ') }}</span>{% endif %}
          {% if f.extra and f.extra.cvss_base %}<span class="kv-key">CVSS Base</span><span class="kv-val mono">{{ f.extra.cvss_base }}</span>{% endif %}
          {% if f.extra and f.extra.cvss_vector %}<span class="kv-key">CVSS Vector</span><span class="kv-val mono" style="font-size:10px;">{{ f.extra.cvss_vector }}</span>{% endif %}
        </div>
      </div>

      {% if f.evidence %}
      <div class="no-break">
        <div class="finding-section-label">Evidence</div>
        <div class="code-block">{{ f.evidence }}</div>
      </div>
      {% endif %}

      {% if f.remediation %}
      <div class="no-break">
        <div class="finding-section-label">Remediation</div>
        {%- if sev == 'critical' -%}{%- set pclass = 'p1' -%}
        {%- elif sev == 'high' -%}{%- set pclass = 'p2' -%}
        {%- else -%}{%- set pclass = 'p3' -%}
        {%- endif -%}
        <div class="priority-item {{ pclass }}" style="border-radius:6px;">
          <span class="priority-text">{{ f.remediation }}</span>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  {% endfor %}
  {% else %}
  <div class="card no-break" style="background:var(--gray-50);">
    <p class="finding-text color-muted">No findings recorded for this engagement.</p>
  </div>
  {% endif %}
</section>

<!-- ══════════════════════════════════════════════════════════
     SECTION 9 — TESTED — NOT EXPLOITABLE
     ══════════════════════════════════════════════════════════ -->
<section class="report-section">
  <div class="section-header">
    <div class="section-header-left">
      <div class="section-number">Section 9</div>
      <h2 class="section-title">Tested — Not Exploitable</h2>
    </div>
  </div>
  <p class="section-lead">The following attack vectors were fully exercised and found to be not exploitable in this engagement. These results are retained as explicit coverage evidence — demonstrating that the attack surface was thoroughly tested, not merely skipped.</p>

  {% set non_exploitable = coverage_tests|selectattr('outcome', 'in', ['negative', 'blocked', 'error'])|list if coverage_tests else [] %}
  {% if non_exploitable %}
  <div class="table-wrap">
    <table class="report-table">
      <thead>
        <tr>
          <th>Attack Vector</th>
          <th>Tool / Technique</th>
          <th>Result</th>
          <th>Coverage Note</th>
        </tr>
      </thead>
      <tbody>
        {% for c in non_exploitable %}
        <tr>
          <td class="font-600">{{ c.command }}</td>
          <td class="mono">{{ c.tool }}</td>
          <td>
            {%- set oc = c.outcome|lower -%}
            {% if oc == 'negative' %}<span class="badge non-exploitable">Negative</span>
            {% elif oc == 'blocked' %}<span class="badge blocked">Blocked</span>
            {% else %}<span class="badge blocked">Error</span>
            {% endif %}
          </td>
          <td>{{ c.note }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="card mt-16 no-break" style="background:var(--sev-low-bg);border-color:var(--sev-low-bdr);">
    <div class="card-title" style="color:var(--sev-low-txt);">Coverage Statement</div>
    <p class="finding-text" style="margin-top:6px;">The above non-exploitable results are a positive finding — they demonstrate that these controls are correctly implemented. These controls should be preserved through future code changes and validated on each major release.</p>
  </div>
  {% else %}
  <div class="card no-break" style="background:var(--gray-50);">
    <p class="finding-text color-muted">No non-exploitable test results recorded for this engagement.</p>
  </div>
  {% endif %}
</section>

<!-- ══════════════════════════════════════════════════════════
     SECTION 10 — DETECTION / PURPLE-TEAM MAPPING
     ══════════════════════════════════════════════════════════ -->
<section class="report-section">
  <div class="section-header">
    <div class="section-header-left">
      <div class="section-number">Section 10</div>
      <h2 class="section-title">Detection &amp; Purple-Team Mapping</h2>
    </div>
  </div>
  <p class="section-lead">The table below maps each major attack stage to its detection opportunity — the telemetry source, specific rule or alert, and whether it was caught during this engagement.</p>

  {% if detection_map %}
  <div class="table-wrap mb-16">
    <table class="report-table">
      <thead>
        <tr>
          <th>Finding / Stage</th>
          <th>Technique</th>
          <th>Detection Opportunity</th>
          <th>Telemetry / Rule</th>
          <th>Caught?</th>
        </tr>
      </thead>
      <tbody>
        {% for d in detection_map %}
        <tr>
          <td><span class="detect-stage">{{ d.finding }}</span></td>
          <td class="mono" style="color:var(--blue-400);font-size:11px;">{{ d.technique }}</td>
          <td>{{ d.opportunity }}</td>
          <td class="mono" style="font-size:11px;">{{ d.telemetry }}</td>
          <td>
            {%- set caught = d.caught|lower if d.caught else 'open' -%}
            {% if caught == 'yes' or caught == 'covered' %}<span class="detect-status covered">Covered</span>
            {% elif caught == 'partial' %}<span class="detect-status partial">Partial</span>
            {% else %}<span class="detect-status open">Open</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="card no-break" style="border-left:4px solid var(--blue-400);">
    <div class="card-title mb-8">Purple-Team Recommendations</div>
    <div class="kv-grid">
      <span class="kv-key">Immediate</span>
      <span class="kv-val">Deploy auditd rules for sudo usage by service accounts and key-file reads. Enable FIM on the web root directory.</span>
      <span class="kv-key">Short-term</span>
      <span class="kv-val">Integrate EDR with process-tree alerting. Configure WAF outbound rules. Ship logs to a centralised SIEM.</span>
      <span class="kv-key">Long-term</span>
      <span class="kv-val">Run tabletop exercises using this kill-chain as the scenario. Schedule quarterly purple-team exercises.</span>
    </div>
  </div>
  {% else %}
  <div class="card no-break" style="background:var(--gray-50);">
    <p class="finding-text color-muted">No detection mapping data available for this engagement.</p>
  </div>
  {% endif %}
</section>

<!-- ══════════════════════════════════════════════════════════
     SECTION 11 — EVIDENCE APPENDIX & CAPTURED LOOT
     ══════════════════════════════════════════════════════════ -->
<section class="report-section">
  <div class="section-header">
    <div class="section-header-left">
      <div class="section-number">Section 11</div>
      <h2 class="section-title">Evidence Appendix &amp; Captured Loot</h2>
    </div>
  </div>

  <div class="card mb-16 no-break" style="background:#fff5ed;border-color:var(--sev-high-bdr);border-left:4px solid var(--sev-high-bdr);">
    <div class="card-title" style="color:var(--sev-high-txt);">Redaction &amp; Integrity Notice</div>
    <p class="finding-text" style="margin-top:6px;">All captured artefacts have been <strong>redacted for client delivery</strong>. SHA-256 hashes allow the client to independently verify artefact integrity. Artefacts are stored encrypted at rest and will be destroyed 30 days post-engagement per ARGUS data-retention policy.</p>
  </div>

  {% if loot_entries %}
  <h3 class="subsection-title">Evidence Register</h3>
  <div class="table-wrap mb-24">
    <table class="report-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Artefact / Source</th>
          <th>Target</th>
          <th>Severity</th>
          <th>SHA-256</th>
          <th>Size</th>
        </tr>
      </thead>
      <tbody>
        {% for l in loot_entries %}
        <tr>
          <td class="mono font-600">{{ l.doi_label }}</td>
          <td class="mono" style="font-size:11px;">{{ l.source }}</td>
          <td class="mono" style="font-size:11px;">{{ l.target }}</td>
          <td><span class="badge {{ l.severity|lower }}">{{ l.severity }}</span></td>
          <td class="mono text-xs color-muted">{{ l.sha256[:16] if l.sha256 else '—' }}…</td>
          <td class="mono text-xs color-muted">{% if l.size_bytes %}{{ l.size_bytes }} B{% else %}—{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <h3 class="subsection-title">Captured Loot — Redacted Samples</h3>
  <div style="display:flex;flex-direction:column;gap:10px;">
    {% for l in loot_entries %}
    <div class="loot-card no-break">
      <div class="loot-header">
        <span class="loot-filename">{{ l.doi_label }} · {{ l.source }}{% if l.target %} &nbsp;·&nbsp; {{ l.target }}{% endif %}</span>
        <span class="loot-hash">{% if l.sha256 %}SHA-256: {{ l.sha256[:16] }}…{% endif %}{% if l.severity %} &nbsp;·&nbsp; {{ l.severity|upper }}{% endif %}</span>
      </div>
      <div class="loot-content"><span class="redacted">[redacted — hash verified, present in encrypted evidence package]</span></div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if creds_summary %}
  <h3 class="subsection-title mt-24">Captured Credentials (Redacted)</h3>
  <div class="table-wrap">
    <table class="report-table">
      <thead>
        <tr>
          <th>Username</th>
          <th>Password</th>
          <th>Domain</th>
          <th>Source</th>
        </tr>
      </thead>
      <tbody>
        {% for cr in creds_summary %}
        <tr>
          <td class="mono font-600">{{ cr.user }}</td>
          <td class="mono"><span class="redacted">{{ cr.password or '••••••(redacted)' }}</span></td>
          <td class="mono">{{ cr.domain or '—' }}</td>
          <td class="text-xs">{{ cr.source }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  {% if not loot_entries and not creds_summary %}
  <div class="card no-break" style="background:var(--gray-50);">
    <p class="finding-text color-muted">No loot or credential data recorded for this engagement.</p>
  </div>
  {% endif %}
</section>

<!-- ══════════════════════════════════════════════════════════
     SECTION 12 — MITRE ATT&CK MAP
     ══════════════════════════════════════════════════════════ -->
<section class="report-section page-break-before">
  <div class="section-header">
    <div class="section-header-left">
      <div class="section-number">Section 12</div>
      <h2 class="section-title">MITRE ATT&amp;CK Map</h2>
    </div>
  </div>
  <p class="section-lead">All techniques observed or exercised during this engagement, mapped to the MITRE ATT&amp;CK Enterprise framework. Exploited techniques are highlighted.</p>

  {% if mitre_mappings %}
  <!-- ATT&CK heatmap — inline SVG derived from mitre_mappings -->
  {%- set tactics_seen = mitre_mappings|map(attribute='tactic')|unique|list -%}
  {%- set col_w = 133 -%}
  {%- set svg_w = [980, (tactics_seen|length * (col_w + 15)) + 16]|max -%}
  <div class="svg-wrap mb-24">
    <svg viewBox="0 0 {{ svg_w }} 180" xmlns="http://www.w3.org/2000/svg" style="width:100%;display:block;font-family:Inter,sans-serif;">
      <rect width="{{ svg_w }}" height="180" fill="#f8f9fc" rx="8"/>
      {%- set blues = ['#0b2044','#0b3060','#0b4080','#0b55a8','#0b66c3','#1a7fd4','#4da3e8','#6db8f2','#8dcef7'] -%}
      {% for tactic in tactics_seen %}
        {%- set col = loop.index0 -%}
        {%- set cx = col * (col_w + 15) + 8 -%}
        {%- set blue = blues[col % blues|length] -%}
        <rect x="{{ cx }}" y="8" width="{{ col_w }}" height="36" rx="5" fill="{{ blue }}"/>
        <text x="{{ cx + col_w // 2 }}" y="24" text-anchor="middle" font-size="8" font-weight="700" fill="white" letter-spacing="0.06em">{{ tactic|upper|truncate(18, True, '') }}</text>
        {%- set tactic_techs = mitre_mappings|selectattr('tactic', 'equalto', tactic)|list -%}
        {% for tech in tactic_techs %}
          {%- set ty = 52 + loop.index0 * 48 -%}
          {%- if ty < 170 -%}
          <rect x="{{ cx }}" y="{{ ty }}" width="{{ col_w }}" height="40" rx="4" fill="#e8112d" opacity="0.9" stroke="#b30e24" stroke-width="1.5"/>
          <text x="{{ cx + col_w // 2 }}" y="{{ ty + 16 }}" text-anchor="middle" font-size="9" font-weight="700" fill="white">{{ tech.technique_id }}</text>
          <text x="{{ cx + col_w // 2 }}" y="{{ ty + 30 }}" text-anchor="middle" font-size="8" fill="rgba(255,255,255,0.85)">{{ tech.technique_name|truncate(20, True, '') }}</text>
          {%- endif -%}
        {% endfor %}
      {% endfor %}
    </svg>
  </div>

  <div class="mitre-grid">
    {% for m in mitre_mappings %}
    <div class="mitre-cell no-break">
      <div class="mitre-tactic">{{ m.tactic }}</div>
      <div class="mitre-id">{{ m.technique_id }}</div>
      <div class="mitre-name">{{ m.technique_name }}</div>
      {% if m.tool_used %}<div class="mitre-note">Tool: {{ m.tool_used }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% else %}
  <div class="card no-break" style="background:var(--gray-50);">
    <p class="finding-text color-muted">No MITRE ATT&amp;CK mapping data available for this engagement.</p>
  </div>
  {% endif %}
</section>

<!-- ══════════════════════════════════════════════════════════
     SECTION 13 — REMEDIATION ROADMAP
     ══════════════════════════════════════════════════════════ -->
<section class="report-section">
  <div class="section-header">
    <div class="section-header-left">
      <div class="section-number">Section 13</div>
      <h2 class="section-title">Remediation Roadmap</h2>
    </div>
  </div>
  <p class="section-lead">Remediation items are grouped into three priority tiers. P1 items are blocking. P2 and P3 items should be tracked in the vulnerability management system with the timelines below.</p>

  {% if findings %}
  {%- set crit_findings = findings|selectattr('severity', 'equalto', 'Critical')|list -%}
  {%- set high_findings = findings|selectattr('severity', 'equalto', 'High')|list -%}
  {%- set med_findings  = findings|selectattr('severity', 'in', ['Medium', 'Low'])|list -%}
  <div class="card-grid-3">
    <!-- P1 Critical -->
    <div class="roadmap-col no-break">
      <div class="roadmap-header p1">
        <span class="roadmap-priority-label">P1 — Critical</span>
        <span class="roadmap-timeline-tag">Immediate / &lt;7 days</span>
      </div>
      <div class="roadmap-body p1">
        {% if crit_findings %}
        {% for f in crit_findings %}
        <div class="roadmap-item p1">
          <div class="roadmap-bullet">{{ loop.index }}</div>
          <div><strong>{{ f.title }}</strong>{% if f.remediation %} — {{ f.remediation }}{% endif %} <span class="text-xs color-muted">({{ f.fid | default('F-%02d'|format(loop.index)) }})</span></div>
        </div>
        {% endfor %}
        {% else %}
        <div class="roadmap-item p1"><div class="roadmap-bullet">—</div><div>No critical findings identified.</div></div>
        {% endif %}
      </div>
    </div>

    <!-- P2 High -->
    <div class="roadmap-col no-break">
      <div class="roadmap-header p2">
        <span class="roadmap-priority-label">P2 — High</span>
        <span class="roadmap-timeline-tag">30 days</span>
      </div>
      <div class="roadmap-body p2">
        {% if high_findings %}
        {% for f in high_findings %}
        <div class="roadmap-item p2">
          <div class="roadmap-bullet">{{ loop.index }}</div>
          <div><strong>{{ f.title }}</strong>{% if f.remediation %} — {{ f.remediation }}{% endif %}</div>
        </div>
        {% endfor %}
        {% else %}
        <div class="roadmap-item p2"><div class="roadmap-bullet">—</div><div>No high findings identified.</div></div>
        {% endif %}
      </div>
    </div>

    <!-- P3 Medium/Low -->
    <div class="roadmap-col no-break">
      <div class="roadmap-header p3">
        <span class="roadmap-priority-label">P3 — Medium / Low</span>
        <span class="roadmap-timeline-tag">90 days</span>
      </div>
      <div class="roadmap-body p3">
        {% if med_findings %}
        {% for f in med_findings %}
        <div class="roadmap-item p3">
          <div class="roadmap-bullet">{{ loop.index }}</div>
          <div><strong>{{ f.title }}</strong>{% if f.remediation %} — {{ f.remediation }}{% endif %}</div>
        </div>
        {% endfor %}
        {% else %}
        <div class="roadmap-item p3"><div class="roadmap-bullet">—</div><div>No medium/low findings identified.</div></div>
        {% endif %}
      </div>
    </div>
  </div>
  {% else %}
  <div class="card no-break" style="background:var(--gray-50);">
    <p class="finding-text color-muted">No findings to remediate for this engagement.</p>
  </div>
  {% endif %}
</section>

<!-- ══════════════════════════════════════════════════════════
     SECTION 14 — ENGAGEMENT TIMELINE & DATA VISUALISATION
     ══════════════════════════════════════════════════════════ -->
<section class="report-section page-break-before">
  <div class="section-header">
    <div class="section-header-left">
      <div class="section-number">Section 14</div>
      <h2 class="section-title">Engagement Timeline &amp; Data Visualisation</h2>
    </div>
  </div>

  <div class="card-grid-2 mb-32">
    <!-- Timeline -->
    <div>
      <h3 class="subsection-title">Engagement Timeline</h3>
      {% if engagement_timeline %}
      <div class="timeline">
        {% for t in engagement_timeline %}
        <div class="timeline-item">
          <div class="timeline-dot {% if 'root' in t.label|lower or 'compromise' in t.label|lower %}critical{% elif 'start' in t.label|lower or 'end' in t.label|lower or 'report' in t.label|lower %}milestone{% endif %}"></div>
          <div class="timeline-time">{{ t.ts }}</div>
          <div class="timeline-label">{{ t.label }}</div>
          {% if t.detail %}<div class="timeline-note">{{ t.detail }}</div>{% endif %}
        </div>
        {% endfor %}
      </div>
      {% else %}
      <div class="card no-break" style="background:var(--gray-50);">
        <p class="finding-text color-muted">No timeline data available.</p>
      </div>
      {% endif %}
    </div>

    <!-- Charts column -->
    <div style="display:flex;flex-direction:column;gap:20px;">

      <!-- Chart 1: Severity Distribution — Donut (hand-computed from summary) -->
      {% if summary %}
      <div class="chart-wrap no-break">
        <div class="chart-title">Severity Distribution — {{ summary.total }} Findings</div>
        {#
          Donut chart angles (degrees, starting at top = -90°):
          Each sev occupies (count/total)*360°. We build arcs manually.
          cx=100 cy=90 R=70 r=42
          Helper: convert angle to point on circle:
            x = cx + R*sin(rad), y = cy - R*cos(rad)
          We do this in Python-style Jinja math.
        #}
        {%- set total = summary.total|int if summary.total else 1 -%}
        {%- set c_frac = summary.critical|int / total -%}
        {%- set h_frac = summary.high|int / total -%}
        {%- set m_frac = summary.medium|int / total -%}
        {%- set l_frac = summary.low|int / total -%}
        {%- set i_frac = summary.info|int / total -%}
        <svg viewBox="0 0 320 180" xmlns="http://www.w3.org/2000/svg" style="width:100%;display:block;font-family:Inter,sans-serif;">
          <!-- Simplified pie representation using rects as proportional bars instead of path math -->
          <!-- Bar chart approach: vertical bars for each severity -->
          {%- set bar_max_h = 100 -%}
          {%- set bar_w = 28 -%}
          {%- set bar_base_y = 130 -%}
          {%- set bar_start_x = 20 -%}
          {%- set bar_gap = 36 -%}
          <!-- Critical -->
          {%- set bh = (summary.critical|int / total * bar_max_h)|int -%}
          <rect x="{{ bar_start_x }}" y="{{ bar_base_y - bh }}" width="{{ bar_w }}" height="{{ bh }}" rx="3" fill="#e8112d"/>
          <text x="{{ bar_start_x + bar_w//2 }}" y="{{ bar_base_y - bh - 4 }}" text-anchor="middle" font-size="11" font-weight="700" fill="#e8112d">{{ summary.critical }}</text>
          <text x="{{ bar_start_x + bar_w//2 }}" y="{{ bar_base_y + 12 }}" text-anchor="middle" font-size="8" fill="#474c62">Crit</text>
          <!-- High -->
          {%- set bh = (summary.high|int / total * bar_max_h)|int -%}
          <rect x="{{ bar_start_x + bar_gap }}" y="{{ bar_base_y - bh }}" width="{{ bar_w }}" height="{{ bh }}" rx="3" fill="#e85d04"/>
          <text x="{{ bar_start_x + bar_gap + bar_w//2 }}" y="{{ bar_base_y - bh - 4 }}" text-anchor="middle" font-size="11" font-weight="700" fill="#e85d04">{{ summary.high }}</text>
          <text x="{{ bar_start_x + bar_gap + bar_w//2 }}" y="{{ bar_base_y + 12 }}" text-anchor="middle" font-size="8" fill="#474c62">High</text>
          <!-- Medium -->
          {%- set bh = (summary.medium|int / total * bar_max_h)|int -%}
          <rect x="{{ bar_start_x + bar_gap*2 }}" y="{{ bar_base_y - bh }}" width="{{ bar_w }}" height="{{ bh }}" rx="3" fill="#d4a017"/>
          <text x="{{ bar_start_x + bar_gap*2 + bar_w//2 }}" y="{{ bar_base_y - bh - 4 }}" text-anchor="middle" font-size="11" font-weight="700" fill="#d4a017">{{ summary.medium }}</text>
          <text x="{{ bar_start_x + bar_gap*2 + bar_w//2 }}" y="{{ bar_base_y + 12 }}" text-anchor="middle" font-size="8" fill="#474c62">Med</text>
          <!-- Low -->
          {%- set bh = (summary.low|int / total * bar_max_h)|int -%}
          <rect x="{{ bar_start_x + bar_gap*3 }}" y="{{ bar_base_y - bh }}" width="{{ bar_w }}" height="{{ bh }}" rx="3" fill="#19a34a"/>
          <text x="{{ bar_start_x + bar_gap*3 + bar_w//2 }}" y="{{ bar_base_y - bh - 4 }}" text-anchor="middle" font-size="11" font-weight="700" fill="#19a34a">{{ summary.low }}</text>
          <text x="{{ bar_start_x + bar_gap*3 + bar_w//2 }}" y="{{ bar_base_y + 12 }}" text-anchor="middle" font-size="8" fill="#474c62">Low</text>
          <!-- Info -->
          {%- set bh = (summary.info|int / total * bar_max_h)|int -%}
          <rect x="{{ bar_start_x + bar_gap*4 }}" y="{{ bar_base_y - bh }}" width="{{ bar_w }}" height="{{ bh }}" rx="3" fill="#0b66c3"/>
          <text x="{{ bar_start_x + bar_gap*4 + bar_w//2 }}" y="{{ bar_base_y - bh - 4 }}" text-anchor="middle" font-size="11" font-weight="700" fill="#0b66c3">{{ summary.info }}</text>
          <text x="{{ bar_start_x + bar_gap*4 + bar_w//2 }}" y="{{ bar_base_y + 12 }}" text-anchor="middle" font-size="8" fill="#474c62">Info</text>
          <!-- Baseline -->
          <line x1="{{ bar_start_x - 4 }}" y1="{{ bar_base_y }}" x2="{{ bar_start_x + bar_gap*4 + bar_w + 8 }}" y2="{{ bar_base_y }}" stroke="#e2e4ec" stroke-width="1.5"/>
          <!-- Summary pill -->
          <rect x="200" y="40" width="106" height="56" rx="6" fill="#fff0f0" stroke="#e8112d" stroke-width="1.5"/>
          <text x="253" y="62" text-anchor="middle" font-size="22" font-weight="800" fill="#0b2044">{{ summary.total }}</text>
          <text x="253" y="78" text-anchor="middle" font-size="9" font-weight="600" fill="#838799" letter-spacing="0.06em">FINDINGS</text>
          {% if outcome %}
          <rect x="200" y="106" width="106" height="32" rx="5" fill="#fff0f0" stroke="#e8112d" stroke-width="1.5"/>
          <text x="253" y="121" text-anchor="middle" font-size="9" font-weight="700" fill="#b30e24" letter-spacing="0.06em">OUTCOME</text>
          <text x="253" y="133" text-anchor="middle" font-size="9" font-weight="800" fill="#e8112d">{{ outcome.label|truncate(18, True, '') }}</text>
          {% endif %}
        </svg>
      </div>
      {% endif %}

      <!-- Chart 2: Attempt-Outcome Breakdown — Horizontal bars from coverage_counts -->
      {% if coverage_counts %}
      <div class="chart-wrap no-break">
        <div class="chart-title">Attempt-Outcome Breakdown</div>
        {%- set max_count = coverage_counts.values()|max|int -%}
        {%- set bar_scale = 200.0 / max_count if max_count > 0 else 1 -%}
        <svg viewBox="0 0 320 {{ (coverage_counts|length * 38) + 30 }}" xmlns="http://www.w3.org/2000/svg" style="width:100%;display:block;font-family:Inter,sans-serif;">
          <line x1="80" y1="10" x2="80" y2="{{ (coverage_counts|length * 38) + 10 }}" stroke="#e2e4ec" stroke-width="1"/>
          {% for outcome_key, cnt in coverage_counts.items() %}
          {%- set y = loop.index0 * 38 + 18 -%}
          {%- set bw = (cnt|int * bar_scale)|int -%}
          {%- set oc = outcome_key|lower -%}
          {%- if oc in ['success', 'exploitable'] -%}{%- set bar_color = '#e8112d' -%}
          {%- elif oc in ['negative'] -%}{%- set bar_color = '#19a34a' -%}
          {%- elif oc in ['blocked', 'error'] -%}{%- set bar_color = '#d4a017' -%}
          {%- else -%}{%- set bar_color = '#0b66c3' -%}
          {%- endif -%}
          <text x="76" y="{{ y + 8 }}" text-anchor="end" font-size="10" font-weight="600" fill="#474c62">{{ outcome_key|capitalize }}</text>
          <rect x="80" y="{{ y }}" width="{{ bw }}" height="20" rx="3" fill="{{ bar_color }}"/>
          <text x="{{ 82 + bw }}" y="{{ y + 14 }}" font-size="10" font-weight="700" fill="{{ bar_color }}">{{ cnt }}</text>
          {% endfor %}
        </svg>
      </div>
      {% endif %}

    </div><!-- /.charts column -->
  </div><!-- /.card-grid-2 -->

  <!-- CVSS Score bar chart from findings -->
  {% if findings %}
  {%- set scored = findings|selectattr('extra')|selectattr('extra.cvss_base')|list -%}
  {% if scored %}
  <h3 class="subsection-title">CVSS Score Distribution — Findings with Scores</h3>
  <div class="chart-wrap no-break">
    {%- set bar_max_h = 98 -%}
    {%- set bar_w = 60 -%}
    {%- set bar_gap = 95 -%}
    {%- set svg_chart_w = scored|length * bar_gap + 80 -%}
    <svg viewBox="0 0 {{ svg_chart_w }} 140" xmlns="http://www.w3.org/2000/svg" style="width:100%;display:block;font-family:Inter,sans-serif;">
      <line x1="60" y1="100" x2="{{ svg_chart_w - 20 }}" y2="100" stroke="#e2e4ec" stroke-width="1.5"/>
      <!-- Critical threshold line -->
      <line x1="60" y1="{{ 100 - 90 }}" x2="{{ svg_chart_w - 20 }}" y2="{{ 100 - 90 }}" stroke="#e8112d" stroke-width="1" stroke-dasharray="4,3" opacity="0.4"/>
      <text x="{{ svg_chart_w - 18 }}" y="{{ 100 - 87 }}" font-size="7" fill="#e8112d" opacity="0.7">9.0</text>
      {% for f in scored|sort(attribute='extra.cvss_base', reverse=True) %}
      {%- set score = f.extra.cvss_base|float -%}
      {%- set bh = (score / 10.0 * bar_max_h)|int -%}
      {%- set bx = loop.index0 * bar_gap + 80 -%}
      {%- set sev = f.severity|lower -%}
      {%- if sev == 'critical' -%}{%- set bc = '#e8112d' -%}
      {%- elif sev == 'high' -%}{%- set bc = '#e85d04' -%}
      {%- elif sev == 'medium' -%}{%- set bc = '#d4a017' -%}
      {%- else -%}{%- set bc = '#19a34a' -%}
      {%- endif -%}
      <rect x="{{ bx }}" y="{{ 100 - bh }}" width="{{ bar_w }}" height="{{ bh }}" rx="4" fill="{{ bc }}"/>
      <text x="{{ bx + bar_w//2 }}" y="115" text-anchor="middle" font-size="9" font-weight="700" fill="{{ bc }}">{{ f.extra.cvss_base }}</text>
      <text x="{{ bx + bar_w//2 }}" y="128" text-anchor="middle" font-size="8" fill="#474c62">{{ f.fid | default('F-%02d'|format(loop.index)) }}</text>
      {% endfor %}
      <!-- Y-axis -->
      <text x="54" y="5"  text-anchor="end" font-size="8" fill="#838799">10</text>
      <text x="54" y="55" text-anchor="end" font-size="8" fill="#838799">5</text>
      <text x="54" y="104" text-anchor="end" font-size="8" fill="#838799">0</text>
      <line x1="58" y1="2" x2="58" y2="100" stroke="#e2e4ec" stroke-width="1"/>
    </svg>
  </div>
  {% endif %}
  {% endif %}
</section>

{% if ai_security and ai_security.findings %}
<!-- ══════════════════════════════════════════════════════════
     SECTION 15 — AI / LLM SECURITY (RED-TEAM)
     ══════════════════════════════════════════════════════════ -->
<section class="report-section page-break-before">
  <div class="section-header">
    <div class="section-header-left">
      <div class="section-number">Section 15</div>
      <h2 class="section-title">AI / LLM Security (Red-Team)</h2>
    </div>
    <span class="risk-badge {% if ai_security.max_aivss >= 9.0 %}critical{% elif ai_security.max_aivss >= 7.0 %}high{% elif ai_security.max_aivss >= 4.0 %}medium{% else %}low{% endif %}">Max AIVSS: {{ ai_security.max_aivss }}</span>
  </div>
  <p class="section-lead">Results of the AI/LLM adversarial red-team exercise. Findings are scored using AIVSS (AI Vulnerability Scoring System) and Attack Success Rate (ASR), and mapped to OWASP LLM Top-10 and MITRE ATLAS.</p>

  <!-- ── Summary stat tiles ── -->
  <div class="stat-tiles" style="grid-template-columns:repeat(4,1fr);margin-bottom:28px;">
    <div class="stat-tile total">
      <div class="tile-count">{{ ai_security.count }}</div>
      <div class="tile-label">AI Findings</div>
    </div>
    <div class="stat-tile {% if ai_security.max_aivss >= 9.0 %}critical{% elif ai_security.max_aivss >= 7.0 %}high{% elif ai_security.max_aivss >= 4.0 %}medium{% else %}low{% endif %}">
      <div class="tile-count">{{ ai_security.max_aivss }}</div>
      <div class="tile-label">Max AIVSS</div>
    </div>
    <div class="stat-tile {% if ai_security.avg_asr >= 70 %}critical{% elif ai_security.avg_asr >= 40 %}high{% elif ai_security.avg_asr >= 20 %}medium{% else %}low{% endif %}">
      <div class="tile-count">{{ ai_security.avg_asr }}%</div>
      <div class="tile-label">Avg ASR</div>
    </div>
    <div class="stat-tile info">
      <div class="tile-count" style="font-size:13px;line-height:1.5;letter-spacing:0;">{{ ai_security.owasp_classes|join(', ') }}</div>
      <div class="tile-label">OWASP-LLM Classes</div>
    </div>
  </div>

  <!-- ── Findings table ── -->
  <h3 class="subsection-title">AI Findings Register</h3>
  <div class="flex gap-8 flex-wrap items-center mb-16">
    <span class="text-xs color-muted font-600" style="letter-spacing:0.06em;text-transform:uppercase;">Severity:</span>
    <span class="badge critical">Critical</span>
    <span class="badge high">High</span>
    <span class="badge medium">Medium</span>
    <span class="badge low">Low</span>
  </div>

  <div class="table-wrap mb-24">
    <table class="report-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Finding</th>
          <th>Severity</th>
          <th>AIVSS</th>
          <th>ASR %</th>
          <th>OWASP-LLM</th>
          <th>ATLAS</th>
          <th>Attack Vector</th>
          <th>Model</th>
        </tr>
      </thead>
      <tbody>
        {% for af in ai_security.findings %}
        {%- set sev = af.severity|lower -%}
        {%- if sev == 'critical' -%}{%- set row_bg = 'background:var(--sev-critical-bg);' -%}
        {%- elif sev == 'high' -%}{%- set row_bg = 'background:var(--sev-high-bg);' -%}
        {%- else -%}{%- set row_bg = '' -%}
        {%- endif -%}
        <tr style="{{ row_bg }}">
          <td class="mono font-600" style="color:var(--sev-{{ sev }}-txt);">AI-{{ '%02d'|format(loop.index) }}</td>
          <td class="font-600">{{ af.title }}</td>
          <td><span class="badge {{ sev }}">{{ af.severity }}</span></td>
          <td class="mono font-600" style="color:var(--sev-{{ sev }}-txt);">{{ af.aivss }}</td>
          <td>
            <!-- ASR inline bar -->
            <div style="display:flex;align-items:center;gap:6px;">
              <div style="width:60px;height:7px;border-radius:4px;background:var(--gray-200);overflow:hidden;">
                <div style="height:100%;width:{{ af.asr }}%;border-radius:4px;background:{%- if af.asr >= 70 -%}var(--sev-critical-bdr){%- elif af.asr >= 40 -%}var(--sev-high-bdr){%- elif af.asr >= 20 -%}var(--sev-medium-bdr){%- else -%}var(--sev-low-bdr){%- endif -%};"></div>
              </div>
              <span class="mono" style="font-size:11px;font-weight:700;color:{%- if af.asr >= 70 -%}var(--sev-critical-txt){%- elif af.asr >= 40 -%}var(--sev-high-txt){%- elif af.asr >= 20 -%}var(--sev-medium-txt){%- else -%}var(--sev-low-txt){%- endif -%};">{{ af.asr }}%</span>
            </div>
          </td>
          <td class="mono" style="color:var(--blue-400);font-size:11px;">{{ af.owasp_llm|default('') }}</td>
          <td class="mono" style="font-size:11px;color:var(--gray-600);">{{ af.atlas|default('') }}</td>
          <td style="font-size:12px;">{{ af.attack_vector|default('') }}</td>
          <td class="mono" style="font-size:11px;">{{ af.target_model|default('') }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- ── Per-finding detailed cards ── -->
  <h3 class="subsection-title">Detailed AI Finding Cards</h3>
  {% for af in ai_security.findings %}
  {%- set sev = af.severity|lower -%}
  {%- set afid = 'AI-' ~ '%02d'|format(loop.index) -%}
  <div class="finding-card no-break">
    <div class="finding-card-header {{ sev }}">
      <div>
        <div class="finding-card-id">{{ afid }} · AIVSS {{ af.aivss }}{% if af.vector|default('') %} ({{ af.vector }}){% endif %}</div>
        <div class="finding-card-name">{{ af.title }}</div>
      </div>
      <div class="finding-card-meta">
        <span class="badge {{ sev }}">{{ af.severity }}</span>
        {% if af.owasp_llm|default('') %}<span class="badge info">{{ af.owasp_llm }}</span>{% endif %}
        {% if af.atlas|default('') %}<span class="badge info">{{ af.atlas }}</span>{% endif %}
      </div>
    </div>
    <div class="finding-card-body">

      <div class="no-break">
        <div class="finding-section-label">AI Red-Team Metadata</div>
        <div class="kv-grid" style="grid-template-columns:140px 1fr;">
          <span class="kv-key">AIVSS Score</span>       <span class="kv-val mono">{{ af.aivss }}</span>
          {% if af.cvss|default('') %}<span class="kv-key">CVSS (Classical)</span><span class="kv-val mono">{{ af.cvss }}</span>{% endif %}
          <span class="kv-key">Attack Success Rate</span>
          <span class="kv-val">
            <div style="display:flex;align-items:center;gap:8px;">
              <div style="width:120px;height:8px;border-radius:4px;background:var(--gray-200);overflow:hidden;">
                <div style="height:100%;width:{{ af.asr }}%;border-radius:4px;background:{%- if af.asr >= 70 -%}var(--sev-critical-bdr){%- elif af.asr >= 40 -%}var(--sev-high-bdr){%- elif af.asr >= 20 -%}var(--sev-medium-bdr){%- else -%}var(--sev-low-bdr){%- endif -%};"></div>
              </div>
              <span class="mono font-700" style="font-size:12px;color:{%- if af.asr >= 70 -%}var(--sev-critical-txt){%- elif af.asr >= 40 -%}var(--sev-high-txt){%- elif af.asr >= 20 -%}var(--sev-medium-txt){%- else -%}var(--sev-low-txt){%- endif -%};">{{ af.asr }}% ({{ af.successes|default(0) }}/{{ af.trials|default(0) }} trials)</span>
            </div>
          </span>
          {% if af.owasp_llm|default('') %}<span class="kv-key">OWASP-LLM</span>     <span class="kv-val mono" style="color:var(--blue-400);">{{ af.owasp_llm }}</span>{% endif %}
          {% if af.atlas|default('') %}<span class="kv-key">MITRE ATLAS</span>   <span class="kv-val mono" style="color:var(--blue-400);">{{ af.atlas }}</span>{% endif %}
          {% if af.attack_vector|default('') %}<span class="kv-key">Attack Vector</span>  <span class="kv-val">{{ af.attack_vector }}</span>{% endif %}
          {% if af.target_model|default('') %}<span class="kv-key">Target Model</span>   <span class="kv-val mono">{{ af.target_model }}</span>{% endif %}
          {% if af.vector|default('') %}<span class="kv-key">AIVSS Vector</span>   <span class="kv-val mono" style="font-size:10px;word-break:break-all;">{{ af.vector }}</span>{% endif %}
        </div>
      </div>

      {% if af.evidence|default('') %}
      <div class="no-break">
        <div class="finding-section-label">Evidence</div>
        <div class="code-block">{{ af.evidence }}</div>
      </div>
      {% endif %}

      {% if af.remediation|default('') %}
      <div class="no-break">
        <div class="finding-section-label">Remediation</div>
        {%- if sev == 'critical' -%}{%- set pclass = 'p1' -%}
        {%- elif sev == 'high' -%}{%- set pclass = 'p2' -%}
        {%- else -%}{%- set pclass = 'p3' -%}
        {%- endif -%}
        <div class="priority-item {{ pclass }}" style="border-radius:6px;">
          <span class="priority-text">{{ af.remediation }}</span>
        </div>
      </div>
      {% endif %}

    </div>
  </div>
  {% endfor %}

  <!-- ── Attack-class distribution bar chart ── -->
  {% if ai_security.by_class %}
  <h3 class="subsection-title mt-32">Attack Vector Distribution</h3>
  <div class="chart-wrap no-break">
    <div class="chart-title">AI Findings by Attack Vector</div>
    {%- set av_max = ai_security.by_class.values()|max|int -%}
    {%- set av_scale = 200.0 / av_max if av_max > 0 else 1 -%}
    {%- set av_count = ai_security.by_class|length -%}
    <svg viewBox="0 0 320 {{ (av_count * 38) + 30 }}" xmlns="http://www.w3.org/2000/svg" style="width:100%;display:block;font-family:Inter,sans-serif;">
      <line x1="100" y1="10" x2="100" y2="{{ (av_count * 38) + 10 }}" stroke="#e2e4ec" stroke-width="1"/>
      {% for av_key, av_cnt in ai_security.by_class.items() %}
      {%- set y = loop.index0 * 38 + 18 -%}
      {%- set bw = (av_cnt|int * av_scale)|int -%}
      <text x="96" y="{{ y + 8 }}" text-anchor="end" font-size="10" font-weight="600" fill="#474c62">{{ av_key|truncate(18, True, '') }}</text>
      <rect x="100" y="{{ y }}" width="{{ bw }}" height="20" rx="3" fill="var(--blue-400)"/>
      <text x="{{ 104 + bw }}" y="{{ y + 14 }}" font-size="10" font-weight="700" fill="var(--blue-400)">{{ av_cnt }}</text>
      {% endfor %}
    </svg>
  </div>
  {% endif %}

</section>
{% endif %}

<!-- ══════════════════════════════════════════════════════════
     FOOTER
     ══════════════════════════════════════════════════════════ -->
<footer class="report-footer">
  <div>
    <div class="footer-brand">ARGUS Security · Autonomous Pentesting Engine</div>
    <div style="margin-top:3px;">Target: {{ target_display }} &nbsp;·&nbsp; Generated: {{ generated_at }}</div>
  </div>
  <div style="text-align:right;">
    <div style="font-weight:600;color:var(--gray-700);">CONFIDENTIAL — CLIENT PRIVILEGED</div>
    <div style="margin-top:3px;">Do not distribute without written consent</div>
  </div>
</footer>

</div><!-- /.page-wrap -->
</body>
</html>






