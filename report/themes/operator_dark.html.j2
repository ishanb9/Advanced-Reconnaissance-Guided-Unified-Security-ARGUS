<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ session.target_hostname|default(target_display) }} | ARGUS Security Assessment | CONFIDENTIAL</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root {
  --bg-base:#0b0d12; --bg-surface:#111318; --bg-card:#161920; --bg-card-alt:#1a1d25; --bg-elevated:#1e2130;
  --border:#252a38; --border-bright:#2e3447;
  --text-primary:#e8eaf0; --text-secondary:#8b92a8; --text-muted:#555e78; --text-dim:#3a4058;
  --cyan:#00d4ff; --cyan-dim:#0099bb; --cyan-glow:rgba(0,212,255,0.15);
  --violet:#8b5cf6; --violet-dim:#6d3fd8; --violet-glow:rgba(139,92,246,0.15);
  --critical:#ff3b5c; --critical-bg:rgba(255,59,92,0.12); --critical-border:rgba(255,59,92,0.35);
  --high:#ff6b2b; --high-bg:rgba(255,107,43,0.12); --high-border:rgba(255,107,43,0.35);
  --medium:#f59e0b; --medium-bg:rgba(245,158,11,0.12); --medium-border:rgba(245,158,11,0.35);
  --low:#3b82f6; --low-bg:rgba(59,130,246,0.12); --low-border:rgba(59,130,246,0.35);
  --info:#6b7280; --info-bg:rgba(107,114,128,0.12); --info-border:rgba(107,114,128,0.35);
  --success:#10b981; --font-mono:"JetBrains Mono","Courier New",monospace; --font-sans:"Inter",system-ui,sans-serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{font-size:14px;scroll-behavior:smooth}
body{font-family:var(--font-sans);background:var(--bg-base);color:var(--text-primary);line-height:1.6;-webkit-font-smoothing:antialiased}
@page{size:A4;margin:18mm 15mm 20mm 15mm}
@media print{
  :root{--bg-base:#fff;--bg-surface:#f8f9fa;--bg-card:#f1f3f7;--bg-card-alt:#eef0f5;--bg-elevated:#e8ebf2;
    --border:#d0d5e0;--border-bright:#b8bfcf;--text-primary:#0f1117;--text-secondary:#3a4058;
    --text-muted:#5a6380;--text-dim:#8b92a8;--cyan:#0077aa;--cyan-dim:#005588;--cyan-glow:transparent;
    --violet:#5b21b6;--violet-glow:transparent;--critical:#c0001a;--critical-bg:rgba(192,0,26,0.06);
    --high:#c04000;--high-bg:rgba(192,64,0,0.06);--medium:#8a5a00;--medium-bg:rgba(138,90,0,0.06);
    --low:#1a3a8a;--low-bg:rgba(26,58,138,0.06);--info:#3a4058;--info-bg:rgba(58,64,88,0.06)}
  body{background:#fff;color:#0f1117;font-size:10pt}
  .cover-page{page-break-after:always;min-height:auto;padding:30mm 0}
  .toc-section{page-break-after:always}
  section{page-break-before:auto}
  .card,table,.finding-card,.roadmap-card,.loot-card{break-inside:avoid}
  nav,.cover-grid-bg,.cover-glow-top,.cover-glow-violet,.print-hide{display:none}
  .cover-banner{background:#c0001a!important;color:#fff!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  a{color:inherit;text-decoration:none}
}
::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:var(--bg-base)}::-webkit-scrollbar-thumb{background:var(--border-bright);border-radius:3px}
.top-nav{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(11,13,18,0.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);padding:0 32px;height:52px;display:flex;align-items:center;justify-content:space-between}
.nav-brand{font-family:var(--font-mono);font-size:12px;color:var(--cyan);letter-spacing:0.1em;text-transform:uppercase}
.nav-links{display:flex;gap:4px;list-style:none}
.nav-links a{font-size:11px;color:var(--text-muted);text-decoration:none;padding:4px 9px;border-radius:4px;font-family:var(--font-mono);transition:all 0.15s}
.nav-links a:hover{color:var(--cyan);background:var(--cyan-glow)}
.nav-badge{font-family:var(--font-mono);font-size:10px;background:var(--critical-bg);color:var(--critical);border:1px solid var(--critical-border);padding:3px 10px;border-radius:3px;letter-spacing:0.08em;text-transform:uppercase}
.page-wrapper{padding-top:52px}
.cover-page{min-height:100vh;display:flex;flex-direction:column;background:var(--bg-base);position:relative;overflow:hidden}
.cover-grid-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(0,212,255,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(0,212,255,0.03) 1px,transparent 1px);background-size:40px 40px;pointer-events:none}
.cover-glow-top{position:absolute;top:-120px;left:50%;transform:translateX(-50%);width:800px;height:400px;background:radial-gradient(ellipse,rgba(0,212,255,0.08) 0%,transparent 70%);pointer-events:none}
.cover-glow-violet{position:absolute;bottom:100px;right:-100px;width:600px;height:400px;background:radial-gradient(ellipse,rgba(139,92,246,0.07) 0%,transparent 70%);pointer-events:none}
.cover-banner{background:var(--critical);color:#fff;text-align:center;font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;padding:8px;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.cover-content{flex:1;display:flex;flex-direction:column;justify-content:center;padding:60px 80px;position:relative;z-index:1}
.cover-eyebrow{font-family:var(--font-mono);font-size:11px;color:var(--cyan);letter-spacing:0.2em;text-transform:uppercase;margin-bottom:24px;display:flex;align-items:center;gap:12px}
.cover-eyebrow::before{content:"";display:block;width:32px;height:1px;background:var(--cyan)}
.cover-title{font-family:var(--font-sans);font-size:clamp(36px,5vw,58px);font-weight:900;line-height:1.05;letter-spacing:-0.02em;color:var(--text-primary);margin-bottom:8px}
.cover-title span{color:var(--cyan)}
.cover-subtitle{font-size:20px;color:var(--text-secondary);font-weight:400;margin-bottom:48px}
.cover-meta-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1px;background:var(--border);border:1px solid var(--border);border-radius:8px;overflow:hidden;max-width:800px;margin-bottom:48px}
.cover-meta-item{background:var(--bg-card);padding:16px 20px}
.cover-meta-label{font-family:var(--font-mono);font-size:10px;color:var(--text-muted);letter-spacing:0.12em;text-transform:uppercase;margin-bottom:4px}
.cover-meta-value{font-family:var(--font-mono);font-size:13px;color:var(--text-primary);font-weight:500}
.cover-badges{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.risk-badge-large{display:inline-flex;align-items:center;gap:8px;background:var(--critical-bg);border:1px solid var(--critical-border);color:var(--critical);padding:10px 20px;border-radius:6px;font-family:var(--font-mono);font-size:14px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;box-shadow:0 0 20px rgba(255,59,92,0.15)}
.risk-badge-large .dot{width:8px;height:8px;border-radius:50%;background:var(--critical);box-shadow:0 0 8px var(--critical);animation:pulse 2s ease-in-out infinite}
.outcome-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(139,92,246,0.1);border:1px solid rgba(139,92,246,0.3);color:var(--violet);padding:10px 20px;border-radius:6px;font-family:var(--font-mono);font-size:13px;font-weight:600;letter-spacing:0.05em}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0.5;transform:scale(0.8)}}
.cover-footer{padding:24px 80px;border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;position:relative;z-index:1}
.cover-footer-left,.cover-footer-right{font-family:var(--font-mono);font-size:11px;color:var(--text-muted)}
section{padding:64px 80px;border-bottom:1px solid var(--border)}
section:nth-child(even){background:var(--bg-surface)}
.section-eyebrow{font-family:var(--font-mono);font-size:10px;color:var(--cyan);letter-spacing:0.2em;text-transform:uppercase;margin-bottom:8px;display:flex;align-items:center;gap:10px}
.section-eyebrow .num{color:var(--text-muted)}
.section-title{font-size:28px;font-weight:800;color:var(--text-primary);margin-bottom:4px;letter-spacing:-0.01em}
.section-title .accent{color:var(--cyan)}
.section-lead{font-size:14px;color:var(--text-secondary);margin-bottom:36px;max-width:700px;line-height:1.7}
.section-divider{width:48px;height:2px;background:linear-gradient(90deg,var(--cyan),transparent);margin-bottom:32px}
.card{background:var(--bg-card);border:1px solid var(--border);border-radius:8px;padding:24px;break-inside:avoid}
.card-header{font-family:var(--font-mono);font-size:10px;color:var(--cyan);letter-spacing:0.15em;text-transform:uppercase;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--border)}
.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:12px;margin-bottom:32px}
.stat-tile{background:var(--bg-card);border-radius:8px;padding:20px 16px;text-align:center;break-inside:avoid;position:relative;overflow:hidden;border:1px solid var(--border)}
.stat-tile::before{content:"";position:absolute;top:0;left:0;right:0;height:2px}
.stat-tile.critical::before{background:var(--critical);box-shadow:0 0 12px var(--critical)}
.stat-tile.high::before{background:var(--high);box-shadow:0 0 12px var(--high)}
.stat-tile.medium::before{background:var(--medium);box-shadow:0 0 12px var(--medium)}
.stat-tile.low::before{background:var(--low);box-shadow:0 0 12px var(--low)}
.stat-tile.info::before{background:var(--info)}
.stat-tile.total::before{background:linear-gradient(90deg,var(--cyan),var(--violet));box-shadow:0 0 12px var(--cyan)}
.stat-tile.access::before{background:var(--violet);box-shadow:0 0 12px var(--violet)}
.stat-number{font-family:var(--font-mono);font-size:36px;font-weight:700;line-height:1;margin-bottom:6px}
.stat-tile.critical .stat-number{color:var(--critical);text-shadow:0 0 20px rgba(255,59,92,0.4)}
.stat-tile.high .stat-number{color:var(--high);text-shadow:0 0 20px rgba(255,107,43,0.4)}
.stat-tile.medium .stat-number{color:var(--medium);text-shadow:0 0 20px rgba(245,158,11,0.4)}
.stat-tile.low .stat-number{color:var(--low);text-shadow:0 0 20px rgba(59,130,246,0.4)}
.stat-tile.info .stat-number{color:var(--info)}
.stat-tile.total .stat-number{color:var(--cyan)}
.stat-tile.access .stat-number{color:var(--violet);font-size:18px;font-weight:800;letter-spacing:0.05em;margin-top:4px}
.stat-label{font-family:var(--font-mono);font-size:10px;color:var(--text-muted);letter-spacing:0.12em;text-transform:uppercase}
.sev{display:inline-block;font-family:var(--font-mono);font-size:10px;font-weight:700;padding:3px 9px;border-radius:3px;letter-spacing:0.08em;text-transform:uppercase;white-space:nowrap}
.sev.critical{background:var(--critical-bg);color:var(--critical);border:1px solid var(--critical-border)}
.sev.high{background:var(--high-bg);color:var(--high);border:1px solid var(--high-border)}
.sev.medium{background:var(--medium-bg);color:var(--medium);border:1px solid var(--medium-border)}
.sev.low{background:var(--low-bg);color:var(--low);border:1px solid var(--low-border)}
.sev.info{background:var(--info-bg);color:var(--info);border:1px solid var(--info-border)}
.status{display:inline-block;font-family:var(--font-mono);font-size:10px;font-weight:600;padding:3px 9px;border-radius:3px;letter-spacing:0.06em;text-transform:uppercase}
.status.verified{background:rgba(16,185,129,0.12);color:#10b981;border:1px solid rgba(16,185,129,0.3)}
.status.open{background:rgba(245,158,11,0.1);color:var(--medium);border:1px solid var(--medium-border)}
.status.gated{background:var(--info-bg);color:var(--info);border:1px solid var(--info-border)}
.table-wrap{overflow-x:auto;border-radius:8px;border:1px solid var(--border);break-inside:avoid}
table{width:100%;border-collapse:collapse;font-size:12px}
thead tr{background:var(--bg-elevated);border-bottom:1px solid var(--border-bright)}
thead th{font-family:var(--font-mono);font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted);padding:12px 16px;text-align:left;font-weight:500;white-space:nowrap}
tbody tr{border-bottom:1px solid var(--border);transition:background 0.1s}
tbody tr:last-child{border-bottom:none}
tbody tr:hover{background:var(--bg-elevated)}
tbody td{padding:12px 16px;color:var(--text-secondary);vertical-align:middle}
tbody td.mono{font-family:var(--font-mono);font-size:11px;color:var(--text-primary)}
.finding-id{font-family:var(--font-mono);font-size:11px;color:var(--cyan);font-weight:600}
.cvss-score{font-family:var(--font-mono);font-size:12px;font-weight:700}
.cvss-critical{color:var(--critical)}.cvss-high{color:var(--high)}.cvss-medium{color:var(--medium)}.cvss-low{color:var(--low)}
.mitre-tag{font-family:var(--font-mono);font-size:10px;color:var(--violet);background:var(--violet-glow);border:1px solid rgba(139,92,246,0.25);padding:2px 7px;border-radius:3px}
.evidence-block{background:#0a0c10;border:1px solid var(--border);border-left:3px solid var(--cyan);border-radius:6px;padding:16px 20px;font-family:var(--font-mono);font-size:11px;color:#a8d8ea;line-height:1.7;overflow-x:auto;white-space:pre-wrap;word-break:break-all;break-inside:avoid}
.evidence-block.red-ev{border-left-color:var(--critical)}
.evidence-block.violet-ev{border-left-color:var(--violet)}
.sha-row{display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:10px;color:var(--text-muted);margin-top:8px;flex-wrap:wrap}
.sha-row .hash{color:#4a9eba;word-break:break-all}
.finding-card{background:var(--bg-card);border:1px solid var(--border);border-radius:10px;margin-bottom:24px;overflow:hidden;break-inside:avoid}
.finding-card-header{display:flex;align-items:center;gap:12px;padding:18px 24px;border-bottom:1px solid var(--border);background:var(--bg-card-alt);flex-wrap:wrap}
.finding-card-id{font-family:var(--font-mono);font-size:12px;color:var(--cyan);font-weight:700}
.finding-card-title{font-size:15px;font-weight:700;color:var(--text-primary);flex:1}
.finding-card-body{padding:24px;display:grid;grid-template-columns:1fr 1fr;gap:24px}
.finding-card-body.single{grid-template-columns:1fr}
.finding-field{margin-bottom:16px}
.finding-field-label{font-family:var(--font-mono);font-size:10px;color:var(--text-muted);letter-spacing:0.12em;text-transform:uppercase;margin-bottom:6px}
.finding-field-value{font-size:13px;color:var(--text-secondary);line-height:1.6}
.scope-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px}
.action-list{list-style:none}
.action-item{display:flex;gap:16px;align-items:flex-start;padding:16px 0;border-bottom:1px solid var(--border)}
.action-item:last-child{border-bottom:none}
.action-num{font-family:var(--font-mono);font-size:11px;color:var(--cyan);width:28px;height:28px;border:1px solid var(--cyan-dim);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-weight:700}
.action-text{font-size:13px;color:var(--text-secondary);line-height:1.6;padding-top:4px}
.action-text strong{color:var(--text-primary)}
.toc-section{background:var(--bg-surface)}
.toc-list{list-style:none}
.toc-item{display:flex;align-items:center;padding:10px 0;border-bottom:1px solid var(--border);gap:12px}
.toc-item:last-child{border-bottom:none}
.toc-num{font-family:var(--font-mono);font-size:11px;color:var(--cyan);width:28px;flex-shrink:0}
.toc-text{font-size:13px;color:var(--text-secondary);flex:1}
.toc-dots{flex:1;border-bottom:1px dotted var(--border-bright);margin:0 8px;min-width:30px}
.cvss-legend{display:flex;gap:8px;flex-wrap:wrap}
.cvss-band{display:flex;flex-direction:column;align-items:center;padding:10px 16px;border-radius:6px;font-family:var(--font-mono);font-size:10px;min-width:90px;text-align:center}
.cvss-band.c{background:var(--critical-bg);border:1px solid var(--critical-border);color:var(--critical)}
.cvss-band.h{background:var(--high-bg);border:1px solid var(--high-border);color:var(--high)}
.cvss-band.m{background:var(--medium-bg);border:1px solid var(--medium-border);color:var(--medium)}
.cvss-band.l{background:var(--low-bg);border:1px solid var(--low-border);color:var(--low)}
.cvss-band.i{background:var(--info-bg);border:1px solid var(--info-border);color:var(--info)}
.cvss-band-label{font-weight:700;font-size:12px;margin-bottom:3px}
.roadmap-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.roadmap-card{background:var(--bg-card);border:1px solid var(--border);border-radius:8px;padding:20px;break-inside:avoid}
.roadmap-card.p1{border-top:2px solid var(--critical)}
.roadmap-card.p2{border-top:2px solid var(--medium)}
.roadmap-card.p3{border-top:2px solid var(--low)}
.roadmap-priority{font-family:var(--font-mono);font-size:11px;font-weight:700;margin-bottom:12px;letter-spacing:0.1em}
.roadmap-card.p1 .roadmap-priority{color:var(--critical)}
.roadmap-card.p2 .roadmap-priority{color:var(--medium)}
.roadmap-card.p3 .roadmap-priority{color:var(--low)}
.roadmap-items{list-style:none}
.roadmap-items li{font-size:12px;color:var(--text-secondary);padding:6px 0 6px 14px;border-bottom:1px solid var(--border);position:relative;line-height:1.5}
.roadmap-items li::before{content:"└─";position:absolute;left:0;font-family:var(--font-mono);font-size:10px;color:var(--text-dim)}
.roadmap-items li:last-child{border-bottom:none}
.timeline{position:relative;padding-left:32px}
.timeline::before{content:"";position:absolute;left:7px;top:8px;bottom:8px;width:1px;background:var(--border-bright)}
.timeline-item{position:relative;margin-bottom:20px;break-inside:avoid}
.timeline-item::before{content:"";position:absolute;left:-28px;top:5px;width:8px;height:8px;border-radius:50%;background:var(--cyan);box-shadow:0 0 8px var(--cyan);border:2px solid var(--bg-base)}
.timeline-time{font-family:var(--font-mono);font-size:10px;color:var(--cyan);letter-spacing:0.05em;margin-bottom:2px}
.timeline-event{font-size:13px;color:var(--text-secondary)}
.timeline-event strong{color:var(--text-primary)}
.mitre-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}
.mitre-phase{background:var(--bg-card);border:1px solid var(--border);border-radius:8px;overflow:hidden;break-inside:avoid}
.mitre-phase-header{background:var(--bg-elevated);padding:10px 14px;font-family:var(--font-mono);font-size:10px;color:var(--violet);letter-spacing:0.1em;text-transform:uppercase;font-weight:600;border-bottom:1px solid var(--border)}
.mitre-phase-item{padding:8px 14px;border-bottom:1px solid var(--border);font-size:12px;color:var(--text-secondary)}
.mitre-phase-item:last-child{border-bottom:none}
.mitre-phase-item .tid{font-family:var(--font-mono);font-size:10px;color:var(--violet);display:block;margin-bottom:2px}
.loot-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.loot-card{background:#0a0c10;border:1px solid var(--border);border-radius:8px;padding:16px;break-inside:avoid}
.loot-card-header{display:flex;align-items:center;gap:10px;margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid var(--border)}
.loot-path{font-family:var(--font-mono);font-size:11px;color:var(--cyan);font-weight:600}
.loot-content{font-family:var(--font-mono);font-size:11px;color:#a8d8ea;line-height:1.6;white-space:pre-wrap;word-break:break-all}
.redact-bar{display:inline-block;background:rgba(255,59,92,0.2);color:var(--critical);border-radius:2px;padding:0 5px;font-size:10px;font-weight:600}
.non-exploit-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px}
.non-exploit-card{background:var(--bg-card-alt);border:1px solid var(--border);border-left:3px solid var(--info);border-radius:6px;padding:14px 16px;break-inside:avoid}
.non-exploit-title{font-size:12px;color:var(--text-primary);font-weight:600;margin-bottom:4px}
.non-exploit-reason{font-family:var(--font-mono);font-size:10px;color:var(--text-muted);line-height:1.5}
.report-footer{padding:32px 80px;background:var(--bg-base);border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}
.footer-brand{font-family:var(--font-mono);font-size:11px;color:var(--cyan);letter-spacing:0.1em}
.footer-conf{font-family:var(--font-mono);font-size:10px;color:var(--text-muted);text-align:center;letter-spacing:0.05em}
.footer-ts{font-family:var(--font-mono);font-size:10px;color:var(--text-muted);text-align:right}
.outcome-exploitable{color:var(--critical);font-family:var(--font-mono);font-size:10px;font-weight:700}
.outcome-negative{color:var(--info);font-family:var(--font-mono);font-size:10px;font-weight:700}
.outcome-success{color:var(--success);font-family:var(--font-mono);font-size:10px;font-weight:700}
.detect-open{color:var(--critical);font-family:var(--font-mono);font-size:10px;font-weight:700}
@media(max-width:900px){section{padding:48px 24px}.cover-content{padding:40px 24px}.cover-footer{padding:20px 24px}.finding-card-body{grid-template-columns:1fr}.roadmap-grid{grid-template-columns:1fr}.scope-grid{grid-template-columns:1fr}.loot-grid{grid-template-columns:1fr}.top-nav{padding:0 16px}.nav-links{display:none}}
</style>
</head>
<body>
<nav class="top-nav print-hide">
  <span class="nav-brand">&#9632; ARGUS // {{ session.target_hostname|default(target_display) }}</span>
  <ul class="nav-links">
    <li><a href="#exec">Exec</a></li><li><a href="#scope">Scope</a></li><li><a href="#method">Method</a></li>
    <li><a href="#killchain">Kill Chain</a></li><li><a href="#attacks">Coverage</a></li>
    <li><a href="#register">Register</a></li><li><a href="#findings">Findings</a></li>
    <li><a href="#loot">Loot</a></li><li><a href="#purple">Purple Team</a></li>
    <li><a href="#mitre">MITRE</a></li><li><a href="#remediation">Roadmap</a></li>
  </ul>
  {% if summary.critical and summary.critical|int > 0 %}
  <span class="nav-badge">&#9888; CRITICAL RISK</span>
  {% elif summary.high and summary.high|int > 0 %}
  <span class="nav-badge">&#9888; HIGH RISK</span>
  {% else %}
  <span class="nav-badge">&#9432; ACTIVE REPORT</span>
  {% endif %}
</nav>
<div class="page-wrapper">
<!-- COVER PAGE -->
<div class="cover-page" id="cover">
  <div class="cover-grid-bg"></div>
  <div class="cover-glow-top"></div>
  <div class="cover-glow-violet"></div>
  <div class="cover-banner">&#9888; CONFIDENTIAL &mdash; CLIENT PRIVILEGED &mdash; DISTRIBUTION RESTRICTED &#9888;</div>
  <div class="cover-content">
    <div class="cover-eyebrow">ARGUS Autonomous Security Platform &nbsp;&bull;&nbsp; {{ engagement_type|default("Security Assessment") }}</div>
    <h1 class="cover-title">Security Assessment<br><span>{{ session.target_hostname|default(target_display) }}</span></h1>
    <p class="cover-subtitle">{{ session.target_ip|default(session.target) }}{% if outcome.label %} &mdash; {{ outcome.label }}{% endif %}</p>
    <div class="cover-meta-grid">
      <div class="cover-meta-item"><div class="cover-meta-label">Target Host</div><div class="cover-meta-value">{{ session.target_ip|default('') }}{% if session.target_hostname %} ({{ session.target_hostname }}){% endif %}</div></div>
      {% if session.started_at or session.completed_at %}
      <div class="cover-meta-item"><div class="cover-meta-label">Engagement Window</div><div class="cover-meta-value">{{ session.started_at|default('') }}{% if session.completed_at %} &ndash; {{ session.completed_at }}{% endif %}</div></div>
      {% endif %}
      <div class="cover-meta-item"><div class="cover-meta-label">Engagement Type</div><div class="cover-meta-value">{{ engagement_type|default('External Pentest') }}</div></div>
      <div class="cover-meta-item"><div class="cover-meta-label">Analyst Engine</div><div class="cover-meta-value">ARGUS Autonomous (Operator-reviewed)</div></div>
      {% if session.scope %}
      <div class="cover-meta-item"><div class="cover-meta-label">Scope</div><div class="cover-meta-value">{{ session.scope }}</div></div>
      {% endif %}
      <div class="cover-meta-item"><div class="cover-meta-label">Report Generated</div><div class="cover-meta-value">{{ generated_at }}</div></div>
      <div class="cover-meta-item"><div class="cover-meta-label">Classification</div><div class="cover-meta-value">CONFIDENTIAL &mdash; Client Privileged</div></div>
    </div>
    <div class="cover-badges">
      {% if summary.critical and summary.critical|int > 0 %}
      <div class="risk-badge-large"><span class="dot"></span>Overall Risk: CRITICAL</div>
      {% elif summary.high and summary.high|int > 0 %}
      <div class="risk-badge-large"><span class="dot"></span>Overall Risk: HIGH</div>
      {% else %}
      <div class="risk-badge-large"><span class="dot"></span>Overall Risk: MEDIUM</div>
      {% endif %}
      {% if outcome.label %}
      <div class="outcome-badge">&#9654; {{ outcome.label }}</div>
      {% endif %}
    </div>
  </div>
  <div class="cover-footer">
    <div class="cover-footer-left">ARGUS Security &bull; Autonomous Operator Platform &bull; argus.internal</div>
    <div class="cover-footer-right">CONFIDENTIAL &mdash; Client Privileged &bull; Not for redistribution</div>
  </div>
</div>

<!-- TOC / DOCUMENT CONTROL -->
<section class="toc-section" id="toc">
  <div class="section-eyebrow"><span class="num">&sect;0</span> Document Control</div>
  <h2 class="section-title">Table of <span class="accent">Contents</span></h2>
  <div class="section-divider"></div>
  <div class="scope-grid" style="margin-bottom:40px">
    <div class="card">
      <div class="card-header">Document Control</div>
      <table>
        <tbody>
          <tr><td style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted);letter-spacing:0.1em;text-transform:uppercase;padding:7px 0;width:40%">Target</td><td style="font-family:var(--font-mono);font-size:12px;padding:7px 0">{{ session.target_hostname|default(target_display) }}</td></tr>
          <tr><td style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted);letter-spacing:0.1em;text-transform:uppercase;padding:7px 0">Generated</td><td style="font-family:var(--font-mono);font-size:12px;padding:7px 0">{{ generated_at }}</td></tr>
          <tr><td style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted);letter-spacing:0.1em;text-transform:uppercase;padding:7px 0">Status</td><td style="padding:7px 0"><span class="status verified">FINAL</span></td></tr>
          {% if duration %}
          <tr><td style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted);letter-spacing:0.1em;text-transform:uppercase;padding:7px 0">Duration</td><td style="font-family:var(--font-mono);font-size:12px;padding:7px 0">{{ duration }}</td></tr>
          {% endif %}
          <tr><td style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted);letter-spacing:0.1em;text-transform:uppercase;padding:7px 0">Analyst</td><td style="font-family:var(--font-mono);font-size:12px;padding:7px 0">ARGUS Autonomous Engine</td></tr>
          <tr><td style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted);letter-spacing:0.1em;text-transform:uppercase;padding:7px 0">Reviewer</td><td style="font-family:var(--font-mono);font-size:12px;padding:7px 0">Operator (Human-in-the-loop)</td></tr>
          <tr><td style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted);letter-spacing:0.1em;text-transform:uppercase;padding:7px 0">Classification</td><td style="font-family:var(--font-mono);font-size:12px;padding:7px 0">CONFIDENTIAL &mdash; Client Privileged</td></tr>
        </tbody>
      </table>
    </div>
    <div class="card">
      <div class="card-header">Severity Legend</div>
      <div style="display:flex;flex-direction:column;gap:10px;padding-top:4px">
        <div style="display:flex;align-items:center;gap:12px"><span class="sev critical">Critical</span><span style="font-family:var(--font-mono);font-size:11px;color:var(--text-muted)">CVSS 9.0&ndash;10.0 &mdash; Immediate action required</span></div>
        <div style="display:flex;align-items:center;gap:12px"><span class="sev high">High</span><span style="font-family:var(--font-mono);font-size:11px;color:var(--text-muted)">CVSS 7.0&ndash;8.9 &mdash; Remediate within 30 days</span></div>
        <div style="display:flex;align-items:center;gap:12px"><span class="sev medium">Medium</span><span style="font-family:var(--font-mono);font-size:11px;color:var(--text-muted)">CVSS 4.0&ndash;6.9 &mdash; Remediate within 90 days</span></div>
        <div style="display:flex;align-items:center;gap:12px"><span class="sev low">Low</span><span style="font-family:var(--font-mono);font-size:11px;color:var(--text-muted)">CVSS 0.1&ndash;3.9 &mdash; Remediate next cycle</span></div>
        <div style="display:flex;align-items:center;gap:12px"><span class="sev info">Info</span><span style="font-family:var(--font-mono);font-size:11px;color:var(--text-muted)">CVSS 0.0 &mdash; Informational / best practice</span></div>
      </div>
    </div>
  </div>
  <ul class="toc-list">
    <li class="toc-item"><span class="toc-num">1</span><span class="toc-text">Executive Summary</span><span class="toc-dots"></span></li>
    <li class="toc-item"><span class="toc-num">2</span><span class="toc-text">System &amp; Scope</span><span class="toc-dots"></span></li>
    <li class="toc-item"><span class="toc-num">3</span><span class="toc-text">Methodology &amp; CVSS Rubric</span><span class="toc-dots"></span></li>
    <li class="toc-item"><span class="toc-num">4</span><span class="toc-text">Attack Path / Kill Chain Graph</span><span class="toc-dots"></span></li>
    <li class="toc-item"><span class="toc-num">5</span><span class="toc-text">Attacks Attempted &mdash; Coverage Log</span><span class="toc-dots"></span></li>
    <li class="toc-item"><span class="toc-num">6</span><span class="toc-text">Findings Register</span><span class="toc-dots"></span></li>
    <li class="toc-item"><span class="toc-num">7</span><span class="toc-text">Detailed Finding Cards</span><span class="toc-dots"></span></li>
    <li class="toc-item"><span class="toc-num">8</span><span class="toc-text">Tested &mdash; Not Exploitable</span><span class="toc-dots"></span></li>
    <li class="toc-item"><span class="toc-num">9</span><span class="toc-text">Captured Loot &amp; Evidence</span><span class="toc-dots"></span></li>
    <li class="toc-item"><span class="toc-num">10</span><span class="toc-text">Detection / Purple-Team Mapping</span><span class="toc-dots"></span></li>
    <li class="toc-item"><span class="toc-num">11</span><span class="toc-text">Evidence Appendix</span><span class="toc-dots"></span></li>
    <li class="toc-item"><span class="toc-num">12</span><span class="toc-text">MITRE ATT&amp;CK Map</span><span class="toc-dots"></span></li>
    <li class="toc-item"><span class="toc-num">13</span><span class="toc-text">Remediation Roadmap</span><span class="toc-dots"></span></li>
    <li class="toc-item"><span class="toc-num">14</span><span class="toc-text">Severity Distribution &amp; Outcome Charts</span><span class="toc-dots"></span></li>
    <li class="toc-item"><span class="toc-num">15</span><span class="toc-text">Engagement Timeline</span><span class="toc-dots"></span></li>
  </ul>
</section>

<!-- SECTION 1: EXECUTIVE SUMMARY -->
<section id="exec">
  <div class="section-eyebrow"><span class="num">&sect;1</span> Executive Summary</div>
  <h2 class="section-title">Executive <span class="accent">Summary</span></h2>
  <div class="section-divider"></div>
  <div class="stat-grid">
    {% if summary.critical is defined %}<div class="stat-tile critical"><div class="stat-number">{{ summary.critical }}</div><div class="stat-label">Critical</div></div>{% endif %}
    {% if summary.high is defined %}<div class="stat-tile high"><div class="stat-number">{{ summary.high }}</div><div class="stat-label">High</div></div>{% endif %}
    {% if summary.medium is defined %}<div class="stat-tile medium"><div class="stat-number">{{ summary.medium }}</div><div class="stat-label">Medium</div></div>{% endif %}
    {% if summary.low is defined %}<div class="stat-tile low"><div class="stat-number">{{ summary.low }}</div><div class="stat-label">Low</div></div>{% endif %}
    {% if summary.info is defined %}<div class="stat-tile info"><div class="stat-number">{{ summary.info }}</div><div class="stat-label">Info</div></div>{% endif %}
    {% if summary.total is defined %}<div class="stat-tile total"><div class="stat-number">{{ summary.total }}</div><div class="stat-label">Total</div></div>{% endif %}
    {% if outcome.root %}<div class="stat-tile access"><div class="stat-number">ROOT</div><div class="stat-label">Access Achieved</div></div>
    {% elif outcome.compromised %}<div class="stat-tile access"><div class="stat-number">OWNED</div><div class="stat-label">Access Achieved</div></div>{% endif %}
  </div>
  {% if executive_summary %}
  <div class="card" style="margin-bottom:28px;border-left:3px solid var(--critical)">
    <div class="card-header">Engagement Outcome</div>
    <p style="font-size:15px;color:var(--text-secondary);line-height:1.8;margin-bottom:16px">{{ executive_summary }}</p>
  </div>
  {% endif %}
  {% if findings %}
  <h3 style="font-size:16px;font-weight:700;color:var(--text-primary);margin-bottom:16px">Priority Actions</h3>
  <ul class="action-list">
    {% for f in findings if f.severity|lower in ['critical','high'] %}
    <li class="action-item">
      <span class="action-num">{{ loop.index }}</span>
      <div class="action-text"><strong>{{ f.title }}</strong> &mdash; {{ f.remediation }}</div>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
</section>

<!-- SECTION 2: SYSTEM & SCOPE -->
<section id="scope">
  <div class="section-eyebrow"><span class="num">&sect;2</span> System &amp; Scope</div>
  <h2 class="section-title">System &amp; <span class="accent">Scope</span></h2>
  <div class="section-divider"></div>
  <div class="scope-grid">
    <div class="card">
      <div class="card-header">Target Profile</div>
      <table><tbody>
        {% if session.target_hostname %}<tr><td style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.1em;padding:7px 0;width:40%">Hostname</td><td style="font-family:var(--font-mono);font-size:12px;color:var(--cyan);padding:7px 0">{{ session.target_hostname }}</td></tr>{% endif %}
        {% if session.target_ip %}<tr><td style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.1em;padding:7px 0">IP Address</td><td style="font-family:var(--font-mono);font-size:12px;padding:7px 0">{{ session.target_ip }}</td></tr>{% endif %}
        {% if intel.os_guess %}<tr><td style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.1em;padding:7px 0">OS</td><td style="font-family:var(--font-mono);font-size:12px;padding:7px 0">{{ intel.os_guess }}</td></tr>{% endif %}
        {% if session.scope %}<tr><td style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.1em;padding:7px 0">Scope</td><td style="font-family:var(--font-mono);font-size:12px;padding:7px 0">{{ session.scope }}</td></tr>{% endif %}
        {% if engagement_type %}<tr><td style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.1em;padding:7px 0">Engagement</td><td style="font-family:var(--font-mono);font-size:12px;padding:7px 0">{{ engagement_type }}</td></tr>{% endif %}
        {% if intel.shell_access %}<tr><td style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.1em;padding:7px 0">Shell Access</td><td style="font-family:var(--font-mono);font-size:12px;padding:7px 0">{{ intel.shell_access }}</td></tr>{% endif %}
      </tbody></table>
    </div>
    <div class="card">
      <div class="card-header">Trust Boundary Note</div>
      <p style="font-size:13px;color:var(--text-secondary);line-height:1.7;margin-bottom:12px">
        This assessment evaluated all attack surfaces within the defined scope. Findings represent confirmed vulnerabilities with validated evidence chains.
      </p>
      <p style="font-family:var(--font-mono);font-size:11px;color:var(--text-muted)">
        Determinism note: time-boxed assessment. Absence of a finding in this report is not proof of absence of the vulnerability.
      </p>
    </div>
  </div>
  {% if intel.open_ports or intel.services %}
  <h3 style="font-size:15px;font-weight:700;color:var(--text-primary);margin-bottom:16px">Open Ports &amp; Services</h3>
  <div class="table-wrap" style="margin-bottom:24px">
    <table>
      <thead><tr><th>Port/Proto</th><th>Service</th><th>Version / Banner</th><th>Notes</th></tr></thead>
      <tbody>
        {% for port, s in intel.services.items() %}
        <tr>
          <td class="mono">{{ port }}</td>
          <td>{{ s.service }}</td>
          <td class="mono">{{ s.version|default('') }}</td>
          <td style="color:var(--text-muted);font-size:12px">{{ s.notes|default('') }}</td>
        </tr>
        {% else %}
        {% for p in intel.open_ports %}
        <tr><td class="mono">{{ p }}</td><td colspan="3" style="color:var(--text-muted);font-size:12px">Port open</td></tr>
        {% endfor %}
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</section>

<!-- SECTION 3: METHODOLOGY -->
<section id="method">
  <div class="section-eyebrow"><span class="num">&sect;3</span> Methodology</div>
  <h2 class="section-title">Methodology &amp; <span class="accent">CVSS Rubric</span></h2>
  <div class="section-divider"></div>
  <div class="scope-grid" style="margin-bottom:32px">
    <div class="card">
      <div class="card-header">Engagement Methodology</div>
      <p style="font-size:13px;color:var(--text-secondary);line-height:1.8;margin-bottom:12px">
        ARGUS operates a <strong style="color:var(--text-primary)">plan &rarr; execute &rarr; validate</strong> loop over a hypothesis tree. Each action is annotated with a MITRE ATT&amp;CK technique and produces an evidence chain before a finding is recorded.
      </p>
      <ul style="list-style:none;display:flex;flex-direction:column;gap:8px">
        <li style="font-size:12px;color:var(--text-muted);padding-left:14px;position:relative"><span style="position:absolute;left:0;color:var(--cyan)">&#8227;</span>Findings ship only when grounded in concrete tool evidence (ARGUS Issue-Validator gate)</li>
        <li style="font-size:12px;color:var(--text-muted);padding-left:14px;position:relative"><span style="position:absolute;left:0;color:var(--cyan)">&#8227;</span>Every exploitable path is re-confirmed on a dedicated retest pass</li>
        <li style="font-size:12px;color:var(--text-muted);padding-left:14px;position:relative"><span style="position:absolute;left:0;color:var(--cyan)">&#8227;</span>Non-exploitable paths are documented as coverage (not omitted)</li>
        <li style="font-size:12px;color:var(--text-muted);padding-left:14px;position:relative"><span style="position:absolute;left:0;color:var(--cyan)">&#8227;</span>All artifacts are integrity-hashed and stored in the secure evidence store</li>
        <li style="font-size:12px;color:var(--text-muted);padding-left:14px;position:relative"><span style="position:absolute;left:0;color:var(--cyan)">&#8227;</span>Time-boxed; absence of finding is not proof of absence</li>
      </ul>
    </div>
    <div class="card">
      <div class="card-header">CVSS v3.1 Scoring Rubric</div>
      <div class="cvss-legend" style="margin-bottom:16px">
        <div class="cvss-band c"><div class="cvss-band-label">Critical</div><div class="cvss-band-range">9.0 &ndash; 10.0</div></div>
        <div class="cvss-band h"><div class="cvss-band-label">High</div><div class="cvss-band-range">7.0 &ndash; 8.9</div></div>
        <div class="cvss-band m"><div class="cvss-band-label">Medium</div><div class="cvss-band-range">4.0 &ndash; 6.9</div></div>
        <div class="cvss-band l"><div class="cvss-band-label">Low</div><div class="cvss-band-range">0.1 &ndash; 3.9</div></div>
        <div class="cvss-band i"><div class="cvss-band-label">Info</div><div class="cvss-band-range">0.0</div></div>
      </div>
      <p style="font-size:12px;color:var(--text-muted);line-height:1.6">
        Scores reflect base CVSS v3.1 vectors. Environmental modifiers applied where client context is known. All scores are independently calculated and peer-reviewed by the operator gate before report inclusion.
      </p>
    </div>
  </div>
</section>

<!-- SECTION 4: ATTACK PATH / KILL CHAIN GRAPH -->
<section id="killchain">
  <div class="section-eyebrow"><span class="num">&sect;4</span> Attack Path</div>
  <h2 class="section-title">Attack Path &amp; <span class="accent">Kill Chain</span></h2>
  <div class="section-divider"></div>
  <p class="section-lead">Full autonomous exploit chain from external attacker to compromise. Each node is colour-coded by MITRE tactic.</p>

  {% if attack_path %}
  <!-- INLINE SVG KILL CHAIN GRAPH - dynamic from attack_path -->
  <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:32px;overflow-x:auto;margin-bottom:24px">
  {% set ns = namespace(node_count=attack_path|length, spacing=0) %}
  {% if ns.node_count > 0 %}
  {% set ns.spacing = [140, (900 // ns.node_count)]|min %}
  {% endif %}
  <svg viewBox="0 0 {{ [960, ns.node_count * (ns.spacing + 10) + 80]|max }} 360" xmlns="http://www.w3.org/2000/svg" style="width:100%;min-width:700px;font-family:'JetBrains Mono',monospace">
    <defs>
      <marker id="arr" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
        <path d="M0,0 L0,6 L8,3 z" fill="#2e3447"/>
      </marker>
      <marker id="arr-red" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
        <path d="M0,0 L0,6 L8,3 z" fill="#ff3b5c"/>
      </marker>
      <marker id="arr-cyan" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
        <path d="M0,0 L0,6 L8,3 z" fill="#00d4ff"/>
      </marker>
      <filter id="glow-cyan"><feGaussianBlur stdDeviation="3" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
      <filter id="glow-red"><feGaussianBlur stdDeviation="4" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    </defs>
    <line x1="0" y1="180" x2="{{ [960, ns.node_count * (ns.spacing + 10) + 80]|max }}" y2="180" stroke="#1e2130" stroke-width="1" stroke-dasharray="4,8"/>
    <!-- Legend row -->
    <rect x="20" y="10" width="10" height="10" rx="2" fill="#00d4ff"/>
    <text x="35" y="20" fill="#8b92a8" font-size="9">Initial Access / Recon</text>
    <rect x="190" y="10" width="10" height="10" rx="2" fill="#8b5cf6"/>
    <text x="205" y="20" fill="#8b92a8" font-size="9">Discovery / Pivot</text>
    <rect x="330" y="10" width="10" height="10" rx="2" fill="#ff6b2b"/>
    <text x="345" y="20" fill="#8b92a8" font-size="9">Persistence / Execution</text>
    <rect x="510" y="10" width="10" height="10" rx="2" fill="#ff3b5c"/>
    <text x="525" y="20" fill="#8b92a8" font-size="9">PrivEsc / Compromise</text>
    <rect x="680" y="10" width="10" height="10" rx="2" fill="#f59e0b"/>
    <text x="695" y="20" fill="#8b92a8" font-size="9">Credential Access</text>
    {% for step in attack_path %}
    {% set x = 20 + loop.index0 * (ns.spacing + 10) %}
    {% set cx = x + 65 %}
    {% if step.phase|lower in ['initial access','reconnaissance','recon','initial-access'] %}
    {% set stroke = "#00d4ff" %}
    {% set fill = "#161920" %}
    {% elif step.phase|lower in ['discovery','pivot','lateral movement'] %}
    {% set stroke = "#8b5cf6" %}
    {% set fill = "#161920" %}
    {% elif step.phase|lower in ['persistence','execution','command and control'] %}
    {% set stroke = "#ff6b2b" %}
    {% set fill = "#161920" %}
    {% elif step.phase|lower in ['privilege escalation','privesc','impact','full compromise'] %}
    {% set stroke = "#ff3b5c" %}
    {% set fill = "#1a0810" %}
    {% elif step.phase|lower in ['credential access','collection','exfiltration'] %}
    {% set stroke = "#f59e0b" %}
    {% set fill = "#161920" %}
    {% else %}
    {% set stroke = "#2e3447" %}
    {% set fill = "#161920" %}
    {% endif %}
    <text x="{{ cx }}" y="130" text-anchor="middle" fill="#3a4058" font-size="9">STAGE {{ loop.index0 }}</text>
    <rect x="{{ x }}" y="138" width="130" height="84" rx="6" fill="{{ fill }}" stroke="{{ stroke }}" stroke-width="1.5"/>
    <text x="{{ cx }}" y="162" text-anchor="middle" fill="{{ stroke }}" font-size="9" font-weight="700">{{ step.phase|upper }}</text>
    <text x="{{ cx }}" y="180" text-anchor="middle" fill="#e8eaf0" font-size="11" font-weight="700">{{ step.result|truncate(18, True, '..') }}</text>
    {% if step.source %}<text x="{{ cx }}" y="196" text-anchor="middle" fill="#8b92a8" font-size="9">{{ step.source|truncate(20, True, '..') }}</text>{% endif %}
    {% if not loop.last %}
    {% set x2 = x + 130 %}
    {% set x3 = x2 + 10 %}
    <line x1="{{ x2 }}" y1="180" x2="{{ x3 }}" y2="180" stroke="{{ stroke }}" stroke-width="1.5" marker-end="url(#arr-{% if stroke == '#ff3b5c' or stroke == '#ff6b2b' %}red{% else %}cyan{% endif %})"/>
    {% endif %}
    {% endfor %}
  </svg>
  </div>
  {% endif %}
</section>

<!-- SECTION 5: ATTACKS ATTEMPTED COVERAGE LOG -->
<section id="attacks">
  <div class="section-eyebrow"><span class="num">&sect;5</span> Coverage Log</div>
  <h2 class="section-title">Attacks Attempted &mdash; <span class="accent">Coverage</span></h2>
  <div class="section-divider"></div>
  <p class="section-lead">Every technique attempted during the engagement, including non-exploitable paths. Coverage transparency is a core ARGUS principle.</p>
  {% if coverage_tests %}
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>#</th><th>Technique / Tool</th><th>Command</th><th>Outcome</th><th>Evidence Note</th></tr>
      </thead>
      <tbody>
        {% for c in coverage_tests %}
        {% if c.outcome|lower == 'success' %}
        <tr>
        {% elif c.outcome|lower in ['negative','blocked','error'] %}
        <tr style="background:rgba(107,114,128,0.04)">
        {% else %}
        <tr style="background:rgba(255,59,92,0.03)">
        {% endif %}
          <td class="mono">{{ "%02d"|format(loop.index) }}</td>
          <td style="font-size:12px;color:var(--text-primary)">{{ c.tool }}</td>
          <td class="mono" style="font-size:10px;color:var(--text-muted);max-width:220px;overflow-wrap:break-word">{{ c.command|truncate(60, True, '..') }}</td>
          <td>
            {% if c.outcome|lower == 'success' %}<span class="outcome-success">SUCCESS</span>
            {% elif c.outcome|lower == 'negative' %}<span class="outcome-negative">NEGATIVE</span>
            {% elif c.outcome|lower == 'blocked' %}<span class="outcome-negative">BLOCKED</span>
            {% elif c.outcome|lower == 'error' %}<span class="outcome-negative">ERROR</span>
            {% else %}<span class="outcome-exploitable">EXPLOITABLE</span>{% endif %}
          </td>
          <td style="font-size:11px;color:var(--text-muted)">{{ c.note }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <p style="color:var(--text-muted);font-family:var(--font-mono);font-size:12px">No coverage log entries recorded for this engagement.</p>
  {% endif %}
</section>

<!-- SECTION 6: FINDINGS REGISTER -->
<section id="register">
  <div class="section-eyebrow"><span class="num">&sect;6</span> Findings Register</div>
  <h2 class="section-title">Findings <span class="accent">Register</span></h2>
  <div class="section-divider"></div>
  {% if findings %}
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>ID</th><th>Finding</th><th>Severity</th><th>CVSS</th><th>Host</th><th>MITRE</th><th>Retest</th></tr>
      </thead>
      <tbody>
        {% for f in findings %}
        <tr>
          <td><span class="finding-id">{{ f.fid | default("F-%02d"|format(loop.index)) }}</span></td>
          <td style="font-size:12px;color:var(--text-primary);font-weight:500">{{ f.title }}</td>
          <td><span class="sev {{ f.severity|lower }}">{{ f.severity }}</span></td>
          <td>
            {% if f.extra and f.extra.cvss_base %}
            <span class="cvss-score cvss-{{ f.severity|lower }}">{{ f.extra.cvss_base }}</span>
            {% else %}<span style="color:var(--text-muted);font-size:11px">N/A</span>{% endif %}
          </td>
          <td class="mono">{{ f.host }}{% if f.port %}:{{ f.port }}{% endif %}</td>
          <td>
            {% if f.mitre %}<span class="mitre-tag">{{ f.mitre }}</span>
            {% else %}<span style="color:var(--text-muted);font-size:11px">N/A</span>{% endif %}
          </td>
          <td>
            {% if f.retest_status|lower == 'verified' %}<span class="status verified">Verified</span>
            {% elif f.retest_status|lower == 'gated' %}<span class="status gated">Gated</span>
            {% else %}<span class="status open">Open</span>{% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <p style="color:var(--text-muted);font-family:var(--font-mono);font-size:12px">No findings recorded for this engagement.</p>
  {% endif %}
</section>

<!-- SECTION 7: DETAILED FINDING CARDS -->
<section id="findings">
  <div class="section-eyebrow"><span class="num">&sect;7</span> Detailed Findings</div>
  <h2 class="section-title">Detailed <span class="accent">Finding Cards</span></h2>
  <div class="section-divider"></div>
  {% if findings %}
  {% for f in findings %}
  <div class="finding-card">
    <div class="finding-card-header">
      <span class="finding-card-id">{{ f.fid | default("F-%02d"|format(loop.index)) }}</span>
      <span class="sev {{ f.severity|lower }}">{{ f.severity }}</span>
      {%- set _etag = f.evidence_tag if f.evidence_tag else (f.extra.evidence_tag if f.extra and f.extra.evidence_tag else '') -%}
      {% if _etag %}<span style="padding:1px 6px;border-radius:4px;font-size:7pt;font-weight:700;background:rgba(128,128,150,0.16);border:1px solid rgba(128,128,150,0.42);">{{ _etag }}</span>{% endif %}
      <span class="finding-card-title">{{ f.title }}</span>
      {%- set _basis = f.severity_rationale if f.severity_rationale else (f.extra.severity_rationale if f.extra and f.extra.severity_rationale else '') -%}
      {% if _basis %}<div style="font-size:7pt;opacity:.68;margin-top:2px;">Severity basis: {{ _basis }}</div>{% endif %}
      {% if f.extra and f.extra.cvss_base %}
      <span class="cvss-score cvss-{{ f.severity|lower }}">CVSS {{ f.extra.cvss_base }}</span>
      {% endif %}
      {% if f.retest_status|lower == 'verified' %}<span class="status verified">Verified</span>
      {% elif f.retest_status|lower == 'gated' %}<span class="status gated">Gated</span>
      {% else %}<span class="status open">Open</span>{% endif %}
    </div>
    <div class="finding-card-body">
      <div>
        {% if f.description %}
        <div class="finding-field">
          <div class="finding-field-label">Description</div>
          <div class="finding-field-value">{{ f.description }}</div>
        </div>
        {% endif %}
        {% if f.mitre %}
        <div class="finding-field">
          <div class="finding-field-label">MITRE ATT&amp;CK</div>
          <div class="finding-field-value"><span class="mitre-tag">{{ f.mitre }}</span></div>
        </div>
        {% endif %}
        <div class="finding-field">
          <div class="finding-field-label">Host / Port</div>
          <div class="finding-field-value" style="font-family:var(--font-mono);font-size:12px;color:var(--cyan)">{{ f.host }}{% if f.port %}:{{ f.port }}{% endif %}</div>
        </div>
        {% if f.extra and f.extra.cvss_vector %}
        <div class="finding-field">
          <div class="finding-field-label">CVSS Vector</div>
          <div class="finding-field-value" style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted);word-break:break-all">{{ f.extra.cvss_vector }}</div>
        </div>
        {% endif %}
        {% if f.cves %}
        <div class="finding-field">
          <div class="finding-field-label">CVEs</div>
          <div class="finding-field-value" style="font-family:var(--font-mono);font-size:11px;color:var(--medium)">{{ f.cves|join(', ') }}</div>
        </div>
        {% endif %}
      </div>
      <div>
        {% if f.evidence %}
        <div class="finding-field">
          <div class="finding-field-label">Evidence</div>
          <div class="evidence-block {% if f.severity|lower == 'critical' %}red-ev{% elif f.severity|lower == 'high' %}red-ev{% endif %}">{{ f.evidence }}</div>
        </div>
        {% endif %}
        {% if f.remediation %}
        <div class="finding-field" style="margin-top:16px">
          <div class="finding-field-label">Remediation</div>
          <div class="finding-field-value">{{ f.remediation }}</div>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
  {% endfor %}
  {% else %}
  <p style="color:var(--text-muted);font-family:var(--font-mono);font-size:12px">No findings recorded for this engagement.</p>
  {% endif %}
</section>

<!-- SECTION 8: TESTED - NOT EXPLOITABLE -->
<section id="non-exploit">
  <div class="section-eyebrow"><span class="num">&sect;8</span> Coverage</div>
  <h2 class="section-title">Tested &mdash; <span class="accent">Not Exploitable</span></h2>
  <div class="section-divider"></div>
  <p class="section-lead">These attack paths were tested exhaustively and did not yield exploitation. They are documented here so the client has a complete picture of coverage, not just confirmed hits.</p>
  {% set non_exploits = coverage_tests|selectattr('outcome', 'in', ['negative','blocked','error'])|list %}
  {% if non_exploits %}
  <div class="non-exploit-grid">
    {% for c in non_exploits %}
    <div class="non-exploit-card">
      <div class="non-exploit-title">{{ c.tool }}</div>
      <div class="non-exploit-reason">{{ c.note }}</div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <p style="color:var(--text-muted);font-family:var(--font-mono);font-size:12px">All tested vectors yielded findings or were not attempted for this engagement type.</p>
  {% endif %}
</section>

<!-- SECTION 9: CAPTURED LOOT / EVIDENCE -->
<section id="loot">
  <div class="section-eyebrow"><span class="num">&sect;9</span> Captured Loot</div>
  <h2 class="section-title">Captured Loot &amp; <span class="accent">Evidence</span></h2>
  <div class="section-divider"></div>
  {% if loot_entries or creds_summary %}
  <div class="card" style="margin-bottom:24px;border-left:3px solid var(--medium)">
    <p style="font-family:var(--font-mono);font-size:11px;color:var(--medium)">&#9888; REDACTION NOTICE: All samples below are redacted. Partial values shown for verification purposes only. Full artifacts are stored in the encrypted ARGUS evidence store and provided under separate secure channel. SHA-256 hashes are over the original, unredacted content.</p>
  </div>
  {% if loot_entries %}
  <div class="loot-grid">
    {% for l in loot_entries %}
    <div class="loot-card">
      <div class="loot-card-header">
        <span class="sev {{ l.severity|lower }}" style="font-size:9px">{{ l.severity|upper }}</span>
        <span class="loot-path">{{ l.doi_label|default(l.target) }}</span>
      </div>
      <div class="loot-content">{{ l.source }}</div>
      {% if l.sha256 %}
      <div class="sha-row"><span class="label">SHA-256:</span><span class="hash">{{ l.sha256 }}</span></div>
      {% endif %}
      {% if l.size_bytes %}
      <div class="sha-row"><span class="label">Size:</span><span class="hash">{{ l.size_bytes }} bytes</span></div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% if creds_summary %}
  <h3 style="font-size:15px;font-weight:700;color:var(--text-primary);margin:24px 0 16px">Captured Credentials</h3>
  <div class="table-wrap">
    <table>
      <thead><tr><th>User</th><th>Password</th><th>Domain</th><th>Source</th></tr></thead>
      <tbody>
        {% for cr in creds_summary %}
        <tr>
          <td class="mono">{{ cr.user }}</td>
          <td class="mono"><span class="redact-bar">{{ cr.password }}</span></td>
          <td class="mono">{{ cr.domain|default('') }}</td>
          <td style="font-size:11px;color:var(--text-muted)">{{ cr.source }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
  {% else %}
  <p style="color:var(--text-muted);font-family:var(--font-mono);font-size:12px">No loot entries recorded for this engagement.</p>
  {% endif %}
</section>

<!-- SECTION 10: PURPLE TEAM MAPPING -->
<section id="purple">
  <div class="section-eyebrow"><span class="num">&sect;10</span> Purple Team</div>
  <h2 class="section-title">Detection &amp; <span class="accent">Purple-Team Mapping</span></h2>
  <div class="section-divider"></div>
  <p class="section-lead">For each stage of the kill chain: the detection opportunity, the specific telemetry or rule needed, and whether it was caught during this engagement.</p>
  {% if detection_map %}
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>#</th><th>Chain Step</th><th>Detection Opportunity</th><th>Telemetry / Rule</th><th>Caught Today?</th></tr>
      </thead>
      <tbody>
        {% for d in detection_map %}
        <tr>
          <td class="mono" style="color:var(--cyan)">{{ loop.index }}</td>
          <td style="font-size:12px;color:var(--text-primary)">{{ d.finding }}</td>
          <td style="font-size:12px;color:var(--text-secondary)">{{ d.opportunity }}</td>
          <td style="font-size:12px;color:var(--text-secondary)">{{ d.telemetry }}</td>
          <td>
            {% if d.caught|lower in ['yes','caught','detected'] %}
            <span class="outcome-success">DETECTED</span>
            {% else %}
            <span class="detect-open">OPEN &mdash; NOT DETECTED</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="card" style="margin-top:20px;border-left:3px solid var(--violet)">
    <div class="card-header">Purple Team Recommendation</div>
    <p style="font-size:13px;color:var(--text-secondary);line-height:1.7">
      {% set caught_count = detection_map|selectattr('caught','in',['yes','caught','detected'])|list|length %}
      {% if caught_count == 0 %}
      None of the kill-chain stages triggered any alert during this engagement. The current telemetry posture would not have detected this compromise. Immediate priorities: (1) deploy FIM on the web root, (2) configure auditd rules for sudo and sensitive file access, (3) onboard EDR with process-tree visibility for the web server process. A purple-team exercise is recommended within 60 days of remediation to validate detection coverage.
      {% else %}
      {{ caught_count }} of {{ detection_map|length }} kill-chain stage(s) triggered detection during this engagement. Review and harden the remaining {{ detection_map|length - caught_count }} undetected stage(s). A purple-team exercise is recommended within 60 days of remediation to validate full detection coverage.
      {% endif %}
    </p>
  </div>
  {% else %}
  <p style="color:var(--text-muted);font-family:var(--font-mono);font-size:12px">No purple-team detection mapping recorded for this engagement.</p>
  {% endif %}
</section>

<!-- SECTION 11: EVIDENCE APPENDIX -->
<section id="evidence">
  <div class="section-eyebrow"><span class="num">&sect;11</span> Evidence Appendix</div>
  <h2 class="section-title">Evidence <span class="accent">Appendix</span></h2>
  <div class="section-divider"></div>
  <p class="section-lead">All artifacts are integrity-hashed (SHA-256), stored in the encrypted ARGUS evidence store. Samples below are redacted.</p>
  {% if loot_entries %}
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Artifact ID</th><th>Type / Label</th><th>Source Path</th><th>Severity</th><th>SHA-256 (truncated)</th></tr>
      </thead>
      <tbody>
        {% for l in loot_entries %}
        <tr>
          <td class="mono" style="color:var(--cyan)">EV-{{ "%02d"|format(loop.index) }}</td>
          <td style="font-size:11px;color:var(--text-muted)">{{ l.doi_label|default('Loot') }}</td>
          <td style="font-size:12px;color:var(--text-secondary)">{{ l.target }}</td>
          <td><span class="sev {{ l.severity|lower }}" style="font-size:9px">{{ l.severity }}</span></td>
          <td class="mono" style="font-size:10px;color:var(--text-muted)">{% if l.sha256 %}{{ l.sha256[:16] }}&hellip;{% else %}N/A{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <p style="color:var(--text-muted);font-family:var(--font-mono);font-size:12px">No evidence artifacts recorded for this engagement.</p>
  {% endif %}
</section>

<!-- SECTION 12: MITRE ATT&CK MAP -->
<section id="mitre">
  <div class="section-eyebrow"><span class="num">&sect;12</span> MITRE ATT&amp;CK</div>
  <h2 class="section-title">MITRE ATT&amp;CK <span class="accent">Map</span></h2>
  <div class="section-divider"></div>
  <p class="section-lead">Techniques observed during this engagement mapped to the MITRE ATT&amp;CK Enterprise framework.</p>
  {% if mitre_mappings %}
  {% set tactics_seen = [] %}
  <div class="mitre-grid">
    {% for tactic in mitre_mappings|map(attribute='tactic')|unique %}
    <div class="mitre-phase">
      <div class="mitre-phase-header">{{ tactic }}</div>
      {% for m in mitre_mappings if m.tactic == tactic %}
      <div class="mitre-phase-item">
        <span class="tid">{{ m.technique_id }}</span>
        {{ m.technique_name }}{% if m.tool_used %} &mdash; <em style="color:var(--text-muted)">{{ m.tool_used }}</em>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  {% else %}
  <p style="color:var(--text-muted);font-family:var(--font-mono);font-size:12px">No MITRE ATT&amp;CK mappings recorded for this engagement.</p>
  {% endif %}
</section>

<!-- SECTION 13: REMEDIATION ROADMAP -->
<section id="remediation">
  <div class="section-eyebrow"><span class="num">&sect;13</span> Remediation</div>
  <h2 class="section-title">Remediation <span class="accent">Roadmap</span></h2>
  <div class="section-divider"></div>
  {% if findings %}
  <div class="roadmap-grid">
    <div class="roadmap-card p1">
      <div class="roadmap-priority">P1 &mdash; NOW (0&ndash;7 days)</div>
      <ul class="roadmap-items">
        {% for f in findings if f.severity|lower == 'critical' %}
        <li>{{ f.title }}: {{ f.remediation|truncate(120, True, '...') }}</li>
        {% else %}
        <li>No critical findings requiring immediate action.</li>
        {% endfor %}
      </ul>
    </div>
    <div class="roadmap-card p2">
      <div class="roadmap-priority">P2 &mdash; SHORT TERM (7&ndash;30 days)</div>
      <ul class="roadmap-items">
        {% for f in findings if f.severity|lower == 'high' %}
        <li>{{ f.title }}: {{ f.remediation|truncate(120, True, '...') }}</li>
        {% else %}
        <li>No high-severity items in this queue.</li>
        {% endfor %}
      </ul>
    </div>
    <div class="roadmap-card p3">
      <div class="roadmap-priority">P3 &mdash; MEDIUM TERM (30&ndash;90 days)</div>
      <ul class="roadmap-items">
        {% for f in findings if f.severity|lower in ['medium','low','info'] %}
        <li>{{ f.title }}: {{ f.remediation|truncate(100, True, '...') }}</li>
        {% else %}
        <li>No medium/low items in this queue.</li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <h3 style="font-size:16px;font-weight:700;color:var(--text-primary);margin:36px 0 16px">Retest &amp; Verification Status</h3>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>ID</th><th>Finding</th><th>Severity</th><th>Retest Status</th><th>Notes</th></tr>
      </thead>
      <tbody>
        {% for f in findings %}
        <tr>
          <td><span class="finding-id">{{ f.fid | default("F-%02d"|format(loop.index)) }}</span></td>
          <td style="font-size:12px">{{ f.title|truncate(50, True, '...') }}</td>
          <td><span class="sev {{ f.severity|lower }}">{{ f.severity }}</span></td>
          <td>
            {% if f.retest_status|lower == 'verified' %}<span class="status verified">Re-confirmed</span>
            {% elif f.retest_status|lower == 'gated' %}<span class="status gated">Gated</span>
            {% else %}<span class="status open">Open</span>{% endif %}
          </td>
          <td style="font-size:11px;color:var(--text-muted)">
            {% if f.retest_status|lower == 'verified' %}Still exploitable; verify remediation before sign-off.
            {% elif f.retest_status|lower == 'gated' %}Blocked by prerequisite finding; validate after P1 fixes.
            {% else %}Pending remediation.{% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <p style="color:var(--text-muted);font-family:var(--font-mono);font-size:12px">No findings to remediate.</p>
  {% endif %}
</section>

{% if ai_security and ai_security.findings %}
<!-- SECTION AI: AI / LLM SECURITY (RED-TEAM) -->
<section id="ai-security">
  <div class="section-eyebrow"><span class="num">&sect;AI</span> AI / LLM Red-Team</div>
  <h2 class="section-title">AI / LLM Security <span class="accent">(Red-Team)</span></h2>
  <div class="section-divider"></div>
  <p class="section-lead">Results of the adversarial AI/LLM red-team exercise. Each finding carries an AIVSS score (0&ndash;10), an Attack Success Rate (ASR%), and mappings to OWASP LLM Top-10 and MITRE ATLAS.</p>

  <!-- Summary banner / stat row -->
  <div class="stat-grid" style="margin-bottom:32px">
    <div class="stat-tile total">
      <div class="stat-number">{{ ai_security.count }}</div>
      <div class="stat-label">AI Findings</div>
    </div>
    <div class="stat-tile critical">
      <div class="stat-number" style="font-size:28px">{{ ai_security.max_aivss }}</div>
      <div class="stat-label">Max AIVSS</div>
    </div>
    <div class="stat-tile high">
      <div class="stat-number" style="font-size:28px">{{ ai_security.avg_asr }}%</div>
      <div class="stat-label">Avg ASR</div>
    </div>
    <div class="stat-tile access">
      <div class="stat-number" style="font-size:13px;letter-spacing:0.03em;margin-top:2px">{{ ai_security.owasp_classes|join(', ') }}</div>
      <div class="stat-label">OWASP-LLM Classes</div>
    </div>
  </div>

  <!-- Findings table -->
  <div class="table-wrap" style="margin-bottom:32px">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Finding</th>
          <th>Severity</th>
          <th>AIVSS</th>
          <th>ASR%</th>
          <th>OWASP-LLM</th>
          <th>ATLAS</th>
          <th>Attack Vector</th>
          <th>Model</th>
        </tr>
      </thead>
      <tbody>
        {% for af in ai_security.findings %}
        <tr>
          <td><span class="finding-id">AI-{{ "%02d"|format(loop.index) }}</span></td>
          <td style="font-size:12px;color:var(--text-primary);font-weight:500">{{ af.title }}</td>
          <td><span class="sev {{ af.severity|lower }}">{{ af.severity }}</span></td>
          <td>
            {% if af.aivss >= 9.0 %}<span class="cvss-score cvss-critical">{{ af.aivss }}</span>
            {% elif af.aivss >= 7.0 %}<span class="cvss-score cvss-high">{{ af.aivss }}</span>
            {% elif af.aivss >= 4.0 %}<span class="cvss-score cvss-medium">{{ af.aivss }}</span>
            {% else %}<span class="cvss-score cvss-low">{{ af.aivss }}</span>{% endif %}
          </td>
          <td>
            <div style="display:flex;align-items:center;gap:6px">
              <span style="font-family:var(--font-mono);font-size:11px;font-weight:700;
                {% if af.asr >= 70 %}color:var(--critical)
                {% elif af.asr >= 40 %}color:var(--high)
                {% elif af.asr >= 20 %}color:var(--medium)
                {% else %}color:var(--low){% endif %}">{{ af.asr }}%</span>
              <div style="width:48px;height:6px;background:var(--border);border-radius:3px;overflow:hidden;flex-shrink:0">
                <div style="height:100%;width:{{ af.asr }}%;border-radius:3px;
                  {% if af.asr >= 70 %}background:var(--critical)
                  {% elif af.asr >= 40 %}background:var(--high)
                  {% elif af.asr >= 20 %}background:var(--medium)
                  {% else %}background:var(--low){% endif %}"></div>
              </div>
            </div>
          </td>
          <td><span class="mitre-tag">{{ af.owasp_llm|default('') }}</span></td>
          <td><span class="mitre-tag" style="color:var(--cyan);border-color:rgba(0,212,255,0.25);background:var(--cyan-glow)">{{ af.atlas|default('') }}</span></td>
          <td style="font-size:11px;color:var(--text-secondary)">{{ af.attack_vector|default('') }}</td>
          <td class="mono" style="font-size:11px;color:var(--text-muted)">{{ af.target_model|default('') }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- Per-finding detail cards -->
  {% for af in ai_security.findings %}
  <div class="finding-card">
    <div class="finding-card-header">
      <span class="finding-card-id">AI-{{ "%02d"|format(loop.index) }}</span>
      <span class="sev {{ af.severity|lower }}">{{ af.severity }}</span>
      <span class="finding-card-title">{{ af.title }}</span>
      <span class="cvss-score {% if af.aivss >= 9.0 %}cvss-critical{% elif af.aivss >= 7.0 %}cvss-high{% elif af.aivss >= 4.0 %}cvss-medium{% else %}cvss-low{% endif %}">AIVSS&nbsp;{{ af.aivss }}</span>
      {% if af.owasp_llm|default('') %}<span class="mitre-tag">{{ af.owasp_llm }}</span>{% endif %}
      {% if af.atlas|default('') %}<span class="mitre-tag" style="color:var(--cyan);border-color:rgba(0,212,255,0.25);background:var(--cyan-glow)">{{ af.atlas }}</span>{% endif %}
    </div>
    <div class="finding-card-body">
      <div>
        <div class="finding-field">
          <div class="finding-field-label">Attack Vector</div>
          <div class="finding-field-value">{{ af.attack_vector|default('') }}</div>
        </div>
        <div class="finding-field">
          <div class="finding-field-label">Target Model</div>
          <div class="finding-field-value" style="font-family:var(--font-mono);font-size:12px;color:var(--cyan)">{{ af.target_model|default('') }}</div>
        </div>
        <div class="finding-field">
          <div class="finding-field-label">ASR / Trials</div>
          <div class="finding-field-value">
            <div style="display:flex;align-items:center;gap:10px">
              <span style="font-family:var(--font-mono);font-size:14px;font-weight:700;
                {% if af.asr >= 70 %}color:var(--critical)
                {% elif af.asr >= 40 %}color:var(--high)
                {% elif af.asr >= 20 %}color:var(--medium)
                {% else %}color:var(--low){% endif %}">{{ af.asr }}%</span>
              <div style="flex:1;height:8px;background:var(--border);border-radius:4px;overflow:hidden">
                <div style="height:100%;width:{{ af.asr }}%;border-radius:4px;
                  {% if af.asr >= 70 %}background:var(--critical);box-shadow:0 0 8px var(--critical)
                  {% elif af.asr >= 40 %}background:var(--high);box-shadow:0 0 8px var(--high)
                  {% elif af.asr >= 20 %}background:var(--medium);box-shadow:0 0 8px var(--medium)
                  {% else %}background:var(--low);box-shadow:0 0 8px var(--low){% endif %}"></div>
              </div>
              <span style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted)">{{ af.successes|default(0) }}/{{ af.trials|default(0) }} trials</span>
            </div>
          </div>
        </div>
        {% if af.vector|default('') %}
        <div class="finding-field">
          <div class="finding-field-label">AIVSS Vector</div>
          <div class="finding-field-value" style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted);word-break:break-all">{{ af.vector }}</div>
        </div>
        {% endif %}
        {% if af.cvss|default(0) %}
        <div class="finding-field">
          <div class="finding-field-label">CVSS Base</div>
          <div class="finding-field-value"><span class="cvss-score cvss-{{ af.severity|lower }}">{{ af.cvss }}</span></div>
        </div>
        {% endif %}
      </div>
      <div>
        {% if af.evidence|default('') %}
        <div class="finding-field">
          <div class="finding-field-label">Evidence</div>
          <div class="evidence-block violet-ev">{{ af.evidence }}</div>
        </div>
        {% endif %}
        {% if af.remediation|default('') %}
        <div class="finding-field" style="margin-top:16px">
          <div class="finding-field-label">Remediation</div>
          <div class="finding-field-value">{{ af.remediation }}</div>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
  {% endfor %}

</section>
{% endif %}

<!-- SECTION 14: CHARTS / DATA-VIZ (pure inline SVG) -->
<section id="charts">
  <div class="section-eyebrow"><span class="num">&sect;14</span> Data Visualisation</div>
  <h2 class="section-title">Severity Distribution &amp; <span class="accent">Outcome Charts</span></h2>
  <div class="section-divider"></div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:32px">

    <!-- Severity Bar Chart - dynamic from summary -->
    <div class="card">
      <div class="card-header">Severity Distribution ({{ summary.total|default(0) }} findings)</div>
      {% set crit_n = summary.critical|default(0)|int %}
      {% set high_n = summary.high|default(0)|int %}
      {% set med_n  = summary.medium|default(0)|int %}
      {% set low_n  = summary.low|default(0)|int %}
      {% set info_n = summary.info|default(0)|int %}
      {% set max_n  = [crit_n, high_n, med_n, low_n, info_n]|max %}
      {% set scale  = 40 if max_n == 0 else (160 / max_n) %}
      <svg viewBox="0 0 320 220" xmlns="http://www.w3.org/2000/svg" style="width:100%">
        <defs>
          <filter id="bar-glow"><feGaussianBlur stdDeviation="2" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        </defs>
        <line x1="48" y1="10" x2="48" y2="175" stroke="#252a38" stroke-width="1"/>
        <line x1="48" y1="175" x2="310" y2="175" stroke="#252a38" stroke-width="1"/>
        <line x1="48" y1="130" x2="310" y2="130" stroke="#1e2130" stroke-width="1" stroke-dasharray="3,4"/>
        <line x1="48" y1="90" x2="310" y2="90" stroke="#1e2130" stroke-width="1" stroke-dasharray="3,4"/>
        <line x1="48" y1="50" x2="310" y2="50" stroke="#1e2130" stroke-width="1" stroke-dasharray="3,4"/>
        <!-- Critical bar -->
        {% set ch = (crit_n * scale)|int %}
        {% set cy = 175 - ch %}
        <rect x="62" y="{{ cy }}" width="38" height="{{ ch }}" rx="3" fill="#ff3b5c" opacity="0.85" filter="url(#bar-glow)"/>
        <text x="81" y="{{ cy - 4 }}" text-anchor="middle" fill="#ff3b5c" font-size="11" font-family="JetBrains Mono,monospace" font-weight="700">{{ crit_n }}</text>
        <text x="81" y="192" text-anchor="middle" fill="#8b92a8" font-size="9" font-family="JetBrains Mono,monospace">Critical</text>
        <!-- High bar -->
        {% set hh = (high_n * scale)|int %}
        {% set hy = 175 - hh %}
        <rect x="112" y="{{ hy }}" width="38" height="{{ hh }}" rx="3" fill="#ff6b2b" opacity="0.85" filter="url(#bar-glow)"/>
        <text x="131" y="{{ hy - 4 }}" text-anchor="middle" fill="#ff6b2b" font-size="11" font-family="JetBrains Mono,monospace" font-weight="700">{{ high_n }}</text>
        <text x="131" y="192" text-anchor="middle" fill="#8b92a8" font-size="9" font-family="JetBrains Mono,monospace">High</text>
        <!-- Medium bar -->
        {% set mh = (med_n * scale)|int %}
        {% set my = 175 - mh %}
        <rect x="162" y="{{ my }}" width="38" height="{{ mh }}" rx="3" fill="#f59e0b" opacity="0.85" filter="url(#bar-glow)"/>
        <text x="181" y="{{ my - 4 }}" text-anchor="middle" fill="#f59e0b" font-size="11" font-family="JetBrains Mono,monospace" font-weight="700">{{ med_n }}</text>
        <text x="181" y="192" text-anchor="middle" fill="#8b92a8" font-size="9" font-family="JetBrains Mono,monospace">Medium</text>
        <!-- Low bar -->
        {% set lh = (low_n * scale)|int %}
        {% set ly = 175 - lh %}
        <rect x="212" y="{{ ly }}" width="38" height="{{ lh }}" rx="3" fill="#3b82f6" opacity="0.85" filter="url(#bar-glow)"/>
        <text x="231" y="{{ ly - 4 }}" text-anchor="middle" fill="#3b82f6" font-size="11" font-family="JetBrains Mono,monospace" font-weight="700">{{ low_n }}</text>
        <text x="231" y="192" text-anchor="middle" fill="#8b92a8" font-size="9" font-family="JetBrains Mono,monospace">Low</text>
        <!-- Info bar -->
        {% set ih = (info_n * scale)|int %}
        {% set iy = 175 - ih %}
        <rect x="262" y="{{ iy }}" width="38" height="{{ ih }}" rx="3" fill="#6b7280" opacity="0.7"/>
        <text x="281" y="{{ iy - 4 }}" text-anchor="middle" fill="#9ca3af" font-size="11" font-family="JetBrains Mono,monospace" font-weight="700">{{ info_n }}</text>
        <text x="281" y="192" text-anchor="middle" fill="#8b92a8" font-size="9" font-family="JetBrains Mono,monospace">Info</text>
        <text x="179" y="210" text-anchor="middle" fill="#555e78" font-size="9" font-family="JetBrains Mono,monospace">Findings by Severity Band</text>
      </svg>
    </div>

    <!-- Attack Outcome Breakdown from coverage_counts -->
    <div class="card">
      {% set total_tests = coverage_tests|length if coverage_tests else 0 %}
      <div class="card-header">Attack Attempt Outcomes ({{ total_tests }} tests)</div>
      {% if coverage_counts %}
      {% set exploit_n = coverage_counts.get('success', 0)|int + coverage_counts.get('exploitable', 0)|int %}
      {% set neg_n     = coverage_counts.get('negative', 0)|int + coverage_counts.get('blocked', 0)|int + coverage_counts.get('error', 0)|int %}
      {% set recon_n   = coverage_counts.get('recon', 0)|int %}
      {% set tot_c     = exploit_n + neg_n + recon_n %}
      {% set tot_c2    = tot_c if tot_c > 0 else 1 %}
      <!-- Donut: exploitable, non-exploitable, recon-only -->
      <!-- angles in degrees, starting from top (270deg), sweep CW -->
      <!-- We'll use fixed approximation: pre-compute arc paths via inline calc -->
      <svg viewBox="0 0 320 220" xmlns="http://www.w3.org/2000/svg" style="width:100%">
        {% set e_ang = (exploit_n / tot_c2 * 360)|round(1) %}
        {% set n_ang = (neg_n / tot_c2 * 360)|round(1) %}
        {% set r_ang = (recon_n / tot_c2 * 360)|round(1) %}
        <!-- Full circle if only one type -->
        {% if exploit_n == tot_c %}
        <circle cx="130" cy="110" r="80" fill="#ff3b5c" opacity="0.9"/>
        <circle cx="130" cy="110" r="48" fill="#161920"/>
        {% elif neg_n == tot_c %}
        <circle cx="130" cy="110" r="80" fill="#6b7280" opacity="0.85"/>
        <circle cx="130" cy="110" r="48" fill="#161920"/>
        {% elif recon_n == tot_c %}
        <circle cx="130" cy="110" r="80" fill="#10b981" opacity="0.85"/>
        <circle cx="130" cy="110" r="48" fill="#161920"/>
        {% else %}
        <!-- Segment 1: Exploitable -->
        <path d="M 130 30 A 80 80 0 0 1 130 190 L 130 158 A 48 48 0 0 0 130 62 Z" fill="#ff3b5c" opacity="0.9"/>
        <!-- Segment 2: Non-exploitable -->
        <path d="M 130 190 A 80 80 0 0 1 52 93 L 69 99 A 48 48 0 0 0 130 158 Z" fill="#6b7280" opacity="0.85"/>
        <!-- Segment 3: Recon -->
        <path d="M 52 93 A 80 80 0 0 1 130 30 L 130 62 A 48 48 0 0 0 69 99 Z" fill="#10b981" opacity="0.85"/>
        {% endif %}
        <text x="130" y="106" text-anchor="middle" fill="#e8eaf0" font-size="22" font-weight="700" font-family="JetBrains Mono,monospace">{{ tot_c }}</text>
        <text x="130" y="122" text-anchor="middle" fill="#8b92a8" font-size="9" font-family="JetBrains Mono,monospace">TOTAL</text>
        <rect x="220" y="70" width="10" height="10" rx="2" fill="#ff3b5c"/>
        <text x="235" y="80" fill="#8b92a8" font-size="11" font-family="JetBrains Mono,monospace">Exploitable ({{ exploit_n }})</text>
        <rect x="220" y="95" width="10" height="10" rx="2" fill="#6b7280"/>
        <text x="235" y="105" fill="#8b92a8" font-size="11" font-family="JetBrains Mono,monospace">Not exploit. ({{ neg_n }})</text>
        <rect x="220" y="120" width="10" height="10" rx="2" fill="#10b981"/>
        <text x="235" y="130" fill="#8b92a8" font-size="11" font-family="JetBrains Mono,monospace">Recon only ({{ recon_n }})</text>
        <text x="160" y="210" text-anchor="middle" fill="#555e78" font-size="9" font-family="JetBrains Mono,monospace">Attack Attempt Outcome Breakdown</text>
      </svg>
      {% else %}
      <p style="color:var(--text-muted);font-family:var(--font-mono);font-size:12px;padding:20px 0">No coverage data available.</p>
      {% endif %}
    </div>
  </div>

  <!-- CVSS Horizontal Bar Chart from findings -->
  {% if findings %}
  <div class="card">
    <div class="card-header">CVSS Scores by Finding</div>
    {% set f_count = findings|length %}
    {% set row_h = 24 %}
    {% set chart_h = f_count * row_h + 40 %}
    <svg viewBox="0 0 720 {{ chart_h }}" xmlns="http://www.w3.org/2000/svg" style="width:100%">
      <defs>
        <filter id="hbar-glow"><feGaussianBlur stdDeviation="1.5" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
      </defs>
      <line x1="60" y1="0" x2="60" y2="{{ chart_h - 20 }}" stroke="#252a38" stroke-width="1"/>
      <line x1="60" y1="{{ chart_h - 20 }}" x2="630" y2="{{ chart_h - 20 }}" stroke="#252a38" stroke-width="1"/>
      {% for tick in range(0, 11) %}
      <text x="{{ 60 + tick * 57 }}" y="{{ chart_h - 5 }}" text-anchor="middle" fill="#555e78" font-size="9" font-family="JetBrains Mono,monospace">{{ tick }}</text>
      {% if tick > 0 %}
      <line x1="{{ 60 + tick * 57 }}" y1="0" x2="{{ 60 + tick * 57 }}" y2="{{ chart_h - 20 }}" stroke="#1e2130" stroke-width="1" stroke-dasharray="2,5"/>
      {% endif %}
      {% endfor %}
      {% for f in findings %}
      {% set cvss = f.extra.cvss_base|default(0)|float if f.extra else 0 %}
      {% set bar_w = (cvss * 57)|int %}
      {% set ry = loop.index0 * row_h + 5 %}
      {% if f.severity|lower == 'critical' %}{% set bar_fill = "#ff3b5c" %}
      {% elif f.severity|lower == 'high' %}{% set bar_fill = "#ff6b2b" %}
      {% elif f.severity|lower == 'medium' %}{% set bar_fill = "#f59e0b" %}
      {% elif f.severity|lower == 'low' %}{% set bar_fill = "#3b82f6" %}
      {% else %}{% set bar_fill = "#6b7280" %}{% endif %}
      <text x="55" y="{{ ry + 12 }}" text-anchor="end" fill="#00d4ff" font-size="10" font-family="JetBrains Mono,monospace">{{ f.fid | default("F-%02d"|format(loop.index)) }}</text>
      {% if bar_w > 0 %}
      <rect x="61" y="{{ ry + 1 }}" width="{{ bar_w }}" height="14" rx="2" fill="{{ bar_fill }}" opacity="0.8" filter="url(#hbar-glow)"/>
      {% endif %}
      {% if cvss > 0 %}
      <text x="{{ 65 + bar_w }}" y="{{ ry + 12 }}" fill="{{ bar_fill }}" font-size="10" font-family="JetBrains Mono,monospace" font-weight="700">{{ cvss }}</text>
      {% else %}
      <text x="65" y="{{ ry + 12 }}" fill="#555e78" font-size="10" font-family="JetBrains Mono,monospace">N/A</text>
      {% endif %}
      {% endfor %}
    </svg>
  </div>
  {% endif %}
</section>

<!-- SECTION 15: ENGAGEMENT TIMELINE -->
<section id="timeline">
  <div class="section-eyebrow"><span class="num">&sect;15</span> Timeline</div>
  <h2 class="section-title">Engagement <span class="accent">Timeline</span></h2>
  <div class="section-divider"></div>
  {% if engagement_timeline %}
  <div class="timeline">
    {% for t in engagement_timeline %}
    <div class="timeline-item">
      <div class="timeline-time">{{ t.ts }}</div>
      <div class="timeline-event"><strong>{{ t.label }}</strong>{% if t.detail %} &mdash; {{ t.detail }}{% endif %}</div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <p style="color:var(--text-muted);font-family:var(--font-mono);font-size:12px">No timeline entries recorded for this engagement.</p>
  {% endif %}
</section>

<!-- FOOTER -->
<footer class="report-footer">
  <div class="footer-brand">&#9632; ARGUS // Autonomous Security Platform</div>
  <div class="footer-conf">CONFIDENTIAL &mdash; CLIENT PRIVILEGED &mdash; {{ session.target_hostname|default(target_display) }}<br>Not for redistribution. Full evidence available via secure evidence portal under NDA.</div>
  <div class="footer-ts">Generated: {{ generated_at }}<br>Version: 1.0 Final</div>
</footer>

</div><!-- end page-wrapper -->
</body>
</html>





