# ARGUS environment configuration
# Edit this file and restart the server — no code changes needed.

# ── Neo4j (semantic relationship graph) ──────────────────────────────────────
# Default Neo4j Community Edition install on localhost.
# Change NEO4J_PASSWORD to whatever you set during Neo4j setup.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=argus123

# ── Ollama (LLM) ─────────────────────────────────────────────────────────────
# Uncomment and edit if your Ollama is on a different host/port
# OLLAMA_URL=http://localhost:11434
# MODEL_NAME=llama3
