# ARGUS — LLM backend configuration
#
# Copy this file to .env and edit the section for the provider you want.
# Only ONE provider needs to be configured; the others can be left blank.
#
# Override LLM_PROVIDER to pin a specific backend.  Leave it set to "auto"
# to probe providers in order at startup (Ollama → OpenAI-compat → Anthropic
# → Gemini) and use the first one that responds.
#
# ===========================================================================

# ── Provider selection ─────────────────────────────────────────────────────
# Values: ollama | openai-compat | claude-code | anthropic | gemini | auto
LLM_PROVIDER=auto

# Wall-clock budget for the slowest individual LLM call.  Streaming means
# this is enforced as the max gap between consecutive tokens — a model
# that produces 1 token / minute will still keep going indefinitely.
# Defaults are fine for most setups; bump if your hardware is very slow.
LLM_PROGRESS_INTERVAL_SEC=30
EXPERT_PREREVIEW_TIMEOUT_SEC=120
EXPERT_POSTREVIEW_TIMEOUT_SEC=120


# ===========================================================================
# 1) Ollama — local, zero-config, no signup, no API key
# ===========================================================================
# Install:   curl -fsSL https://ollama.com/install.sh | sh
# Pull:      ollama pull llama3.1:8b   (or qwen2.5, deepseek-r1, mistral, etc.)
# Run:       ollama serve    (defaults to localhost:11434)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b


# ===========================================================================
# 2) OpenAI-compatible — covers ALL of these with the SAME config keys:
# ===========================================================================
#   - OpenAI proper          OPENAI_BASE_URL=https://api.openai.com/v1
#   - LM Studio (local)      OPENAI_BASE_URL=http://localhost:1234/v1
#   - vLLM (local)           OPENAI_BASE_URL=http://localhost:8000/v1
#   - llama.cpp server       OPENAI_BASE_URL=http://localhost:8080/v1
#   - Groq (fast, free tier) OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   - OpenRouter             OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   - Together AI            OPENAI_BASE_URL=https://api.together.xyz/v1
#   - HuggingFace TGI        OPENAI_BASE_URL=https://api-inference.huggingface.co/v1
#   - Cloudflare Workers AI  OPENAI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<id>/ai/v1
#
# OPENAI_API_KEY is optional for local servers (LM Studio, vLLM, llama.cpp).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# ===========================================================================
# 3) Anthropic Claude — free credits on signup at console.anthropic.com
# ===========================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Override only if using a self-hosted Anthropic-compatible gateway
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MAX_TOKENS=4096


# ===========================================================================
# 4) Google Gemini — generous free tier at aistudio.google.com
# ===========================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash


# ===========================================================================
# 5) Claude Code CLI — uses your claude.ai Pro/Max subscription via OAuth.
#                      No API key needed; spends subscription quota instead.
# ===========================================================================
# One-time setup on Kali:
#    npm install -g @anthropic-ai/claude-code
#    claude login                  # opens browser, sign in with claude.ai
#
# After that the OAuth token is stored at ~/.claude/.credentials.json and
# every `claude --print` invocation transparently uses your subscription.
#
# CAVEATS
#   - claude.ai *web chat* CANNOT be used as a backend — no public API
#     and scraping it violates Anthropic's ToS.  This provider is the
#     supported subscription-based path.
#   - Each LLM call spawns a subprocess (~200-500 ms overhead per call).
#   - Heartbeat (llm_progress) still fires while waiting on Claude.
#
# Override the CLI path only if `claude` isn't on PATH for the user
# running agent_server.py:
CLAUDE_CODE_BIN=
CLAUDE_CODE_MODEL=claude-sonnet-4-5


# ===========================================================================
# Recommended pairings
# ===========================================================================
#
#   No internet, no signup, no API key:
#     LLM_PROVIDER=ollama
#     OLLAMA_MODEL=llama3.1:8b
#
#   Best free-tier hosted (fast, generous quota):
#     LLM_PROVIDER=openai-compat
#     OPENAI_BASE_URL=https://api.groq.com/openai/v1
#     OPENAI_API_KEY=gsk_...   (free, sign up at groq.com)
#     OPENAI_MODEL=llama-3.3-70b-versatile
#
#   Best paid-tier reasoning:
#     LLM_PROVIDER=anthropic
#     ANTHROPIC_API_KEY=sk-ant-...
#     ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
#
#   Claude via your subscription (no API key, uses Pro/Max quota):
#     LLM_PROVIDER=claude-code
#     CLAUDE_CODE_MODEL=claude-sonnet-4-5
#     # (after one-time `claude login` on this machine)
#
#   Bring-your-own (any OpenAI-compatible server):
#     LLM_PROVIDER=openai-compat
#     OPENAI_BASE_URL=http://localhost:1234/v1   # e.g. LM Studio
#     OPENAI_MODEL=local-model
